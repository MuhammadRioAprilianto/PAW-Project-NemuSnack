<!-- Agency-Level Navbar NemuSnack -->
<header class="sticky top-0 z-50 bg-[#FAF8F5]/90 backdrop-blur-md transition-all duration-300 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo (Inspired by Agency Reference) -->
      <a href="/" class="flex items-center space-x-3 group">
        <div class="w-11 h-11 rounded-2xl bg-brand-orange flex items-center justify-center text-white shadow-lg shadow-brand-orange/30 group-hover:scale-105 transition-transform duration-200">
          <!-- Food / Utensils SVG -->
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/>
          </svg>
        </div>
        <div>
          <span class="text-2xl font-black text-gray-900 tracking-tight flex items-center">
            Nemu<span class="text-brand-orange">Snack</span>
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links (Centered, Elegant) -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-4">
        <a href="/" 
           class="px-4 py-2 rounded-full text-sm font-bold transition-all duration-200 <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'text-brand-orange bg-orange-100/60' : 'text-gray-700 hover:text-brand-orange hover:bg-orange-50' %>">
          Home
        </a>

        <a href="/menu" 
           class="px-4 py-2 rounded-full text-sm font-bold transition-all duration-200 <%= (typeof currentPath !== 'undefined' && currentPath === '/menu') ? 'text-brand-orange bg-orange-100/60' : 'text-gray-700 hover:text-brand-orange hover:bg-orange-50' %>">
          Menu Jajanan
        </a>

        <a href="/#map-tracking" 
           class="px-4 py-2 rounded-full text-sm font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50 transition-all duration-200 flex items-center">
          <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse"></span>
          Pelacakan Peta
        </a>

        <a href="/#why-us" 
           class="px-4 py-2 rounded-full text-sm font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50 transition-all duration-200">
          Kenapa Kami
        </a>

        <a href="/#ai-assistant" 
           class="px-4 py-2 rounded-full text-sm font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50 transition-all duration-200 flex items-center">
          <span class="mr-1 text-xs">✨</span> Rekomendasi
        </a>
      </nav>

      <!-- Desktop Action Icons & Pill CTA Button -->
      <div class="hidden md:flex items-center space-x-4">
        
        <!-- Search Quick Icon -->
        <a href="/menu" class="p-2.5 rounded-full text-gray-700 hover:text-brand-orange hover:bg-orange-50 transition-colors" title="Cari Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </a>

        <!-- Cart / Bookmark Badge Icon -->
        <a href="/menu" class="relative p-2.5 rounded-full text-gray-700 hover:text-brand-orange hover:bg-orange-50 transition-colors" title="Koleksi Lapak">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          <span class="absolute top-1 right-1 w-4 h-4 rounded-full bg-brand-orange text-white text-[10px] font-black flex items-center justify-center">
            6
          </span>
        </a>

        <!-- Primary Pill Button (Matching Reference) -->
        <a href="/menu" 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full font-extrabold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover shadow-lg shadow-brand-orange/30 hover:shadow-xl hover:shadow-brand-orange/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
          <span>Jelajahi Lapak</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden items-center">
        <button id="mobile-menu-btn" 
                type="button" 
                class="p-2.5 rounded-full text-gray-700 hover:text-brand-orange hover:bg-orange-50 focus:outline-none" 
                aria-label="Buka menu navigasi">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-[#FAF8F5] px-4 pt-3 pb-6 shadow-xl">
    <div class="space-y-1.5">
      <a href="/" 
         class="block px-4 py-2.5 rounded-2xl text-base font-bold <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'text-brand-orange bg-orange-100/60' : 'text-gray-700 hover:text-brand-orange hover:bg-orange-50' %>">
        Home
      </a>
      <a href="/menu" 
         class="block px-4 py-2.5 rounded-2xl text-base font-bold <%= (typeof currentPath !== 'undefined' && currentPath === '/menu') ? 'text-brand-orange bg-orange-100/60' : 'text-gray-700 hover:text-brand-orange hover:bg-orange-50' %>">
        Menu Jajanan
      </a>
      <a href="/#map-tracking" 
         class="block px-4 py-2.5 rounded-2xl text-base font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50 flex items-center">
        <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse"></span>
        Pelacakan Peta
      </a>
      <a href="/#why-us" 
         class="block px-4 py-2.5 rounded-2xl text-base font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50">
        Kenapa Kami
      </a>
      <a href="/#ai-assistant" 
         class="block px-4 py-2.5 rounded-2xl text-base font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50">
        ✨ Asisten Rekomendasi
      </a>
    </div>

    <div class="mt-4 pt-3 border-t border-gray-200">
      <a href="/menu" 
         class="w-full flex items-center justify-center px-5 py-3.5 rounded-full font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover shadow-lg shadow-brand-orange/25">
        <span>Jelajahi Lapak Sekarang</span>
      </a>
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
