<!-- Navbar Kebab Corner -->
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-brand-warm shadow-sm transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-brand-brown to-brand-orange flex items-center justify-center text-white shadow-md shadow-brand-orange/20 group-hover:scale-105 transition-transform duration-200">
          <!-- Kebab Icon SVG -->
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M19.78 2.22a.75.75 0 0 0-1.06 0L17 3.94 13.06 0 11.65 1.41l3.94 3.94-2.12 2.12-3.94-3.94-1.41 1.41 3.94 3.94-2.12 2.12-3.94-3.94L4.59 8.47l3.94 3.94-2.35 2.35a3.75 3.75 0 0 0 0 5.3l1.88 1.88a3.75 3.75 0 0 0 5.3 0l2.35-2.35 3.94 3.94 1.41-1.41-3.94-3.94 2.12-2.12 3.94 3.94 1.41-1.41-3.94-3.94 2.12-2.12 3.94 3.94 1.41-1.41-3.94-3.94 1.72-1.72a.75.75 0 0 0 0-1.06l-4.59-4.59 4.59-4.59a.75.75 0 0 0 0-1.06zM7.24 18.94a2.25 2.25 0 0 1-3.18-3.18l2-2 3.18 3.18-2 2z"/>
          </svg>
        </div>
        <div>
          <span class="text-2xl font-extrabold text-brand-brown tracking-tight flex items-center">
            Kebab <span class="text-brand-orange ml-1">Corner</span>
          </span>
          <p class="text-[10px] text-gray-500 font-medium tracking-wider uppercase -mt-1">Fresh & Tasty Kebabs</p>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        <a href="/" 
           class="px-4 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'text-brand-orange bg-brand-warm' : 'text-gray-700 hover:text-brand-orange hover:bg-gray-50' %>">
          Home
        </a>

        <a href="/menu" 
           class="px-4 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 <%= (typeof currentPath !== 'undefined' && currentPath === '/menu') ? 'text-brand-orange bg-brand-warm' : 'text-gray-700 hover:text-brand-orange hover:bg-gray-50' %>">
          Menu
        </a>

        <a href="/#about" 
           class="px-4 py-2 rounded-lg text-sm font-semibold text-gray-700 hover:text-brand-orange hover:bg-gray-50 transition-colors duration-200">
          Tentang Kami
        </a>

        <a href="/#contact" 
           class="px-4 py-2 rounded-lg text-sm font-semibold text-gray-700 hover:text-brand-orange hover:bg-gray-50 transition-colors duration-200">
          Kontak
        </a>
      </nav>

      <!-- Desktop CTA Action Button -->
      <div class="hidden md:flex items-center space-x-3">
        <a href="/menu" 
           class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover shadow-md shadow-brand-orange/25 hover:shadow-lg hover:shadow-brand-orange/35 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
          <span>Pesan Sekarang</span>
          <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden items-center">
        <button id="mobile-menu-btn" 
                type="button" 
                class="p-2.5 rounded-lg text-gray-600 hover:text-brand-orange hover:bg-brand-warm focus:outline-none focus:ring-2 focus:ring-brand-orange" 
                aria-label="Buka menu navigasi">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white px-4 pt-3 pb-6 shadow-xl transition-all duration-300">
    <div class="space-y-1">
      <a href="/" 
         class="block px-3 py-2.5 rounded-lg text-base font-semibold <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'text-brand-orange bg-brand-warm' : 'text-gray-700 hover:text-brand-orange hover:bg-gray-50' %>">
        Home
      </a>
      <a href="/menu" 
         class="block px-3 py-2.5 rounded-lg text-base font-semibold <%= (typeof currentPath !== 'undefined' && currentPath === '/menu') ? 'text-brand-orange bg-brand-warm' : 'text-gray-700 hover:text-brand-orange hover:bg-gray-50' %>">
        Menu
      </a>
      <a href="/#about" 
         class="block px-3 py-2.5 rounded-lg text-base font-semibold text-gray-700 hover:text-brand-orange hover:bg-gray-50">
        Tentang Kami
      </a>
      <a href="/#contact" 
         class="block px-3 py-2.5 rounded-lg text-base font-semibold text-gray-700 hover:text-brand-orange hover:bg-gray-50">
        Kontak
      </a>
    </div>

    <div class="mt-4 pt-4 border-t border-gray-100">
      <a href="/menu" 
         class="w-full flex items-center justify-center px-5 py-3 rounded-xl font-bold text-base text-white bg-brand-orange hover:bg-brand-orange-hover shadow-md shadow-brand-orange/20">
        <span>Pesan Sekarang</span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Script navigasi responsif mobile
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });

    // Tutup menu mobile ketika link di dalamnya diklik
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
