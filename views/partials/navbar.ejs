<!-- Navbar NemuSnack -->
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-orange-100 shadow-sm transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo NemuSnack -->
      <a href="/" class="flex items-center space-x-3 group">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-brand-orange to-brand-amber flex items-center justify-center text-white shadow-md shadow-brand-orange/20 group-hover:scale-105 transition-transform duration-200">
          <!-- Pin Location & Food Icon SVG -->
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
        </div>
        <div>
          <span class="text-2xl font-black text-gray-900 tracking-tight flex items-center">
            Nemu<span class="text-brand-orange ml-0.5">Snack</span>
          </span>
          <p class="text-[10px] text-gray-500 font-semibold tracking-wider uppercase -mt-1">Peta &amp; Jajanan Kaki Lima (PKL)</p>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        <a href="/" 
           class="px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'text-brand-orange bg-orange-50' : 'text-gray-700 hover:text-brand-orange hover:bg-gray-50' %>">
          Home
        </a>

        <a href="/menu" 
           class="px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 <%= (typeof currentPath !== 'undefined' && currentPath === '/menu') ? 'text-brand-orange bg-orange-50' : 'text-gray-700 hover:text-brand-orange hover:bg-gray-50' %>">
          Katalog Jajanan &amp; Lapak
        </a>

        <a href="/#ai-assistant" 
           class="px-3.5 py-2 rounded-lg text-sm font-semibold text-gray-700 hover:text-brand-orange hover:bg-gray-50 transition-colors duration-200 flex items-center">
          <span class="mr-1 text-xs">✨</span> Asisten AI
        </a>

        <a href="/#about" 
           class="px-3.5 py-2 rounded-lg text-sm font-semibold text-gray-700 hover:text-brand-orange hover:bg-gray-50 transition-colors duration-200">
          Tentang PRD
        </a>
      </nav>

      <!-- Desktop User / Student Badge & CTA -->
      <div class="hidden md:flex items-center space-x-3">
        <div class="text-right hidden lg:block">
          <p class="text-[11px] font-bold text-gray-800">Muhammad Rio Aprilianto</p>
          <p class="text-[10px] font-mono text-gray-500">20240140204 • PAW</p>
        </div>

        <a href="/menu" 
           class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl font-bold text-xs text-white bg-brand-orange hover:bg-brand-orange-hover shadow-md shadow-brand-orange/25 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
          <span>Pantau Lapak PKL</span>
          <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden items-center">
        <button id="mobile-menu-btn" 
                type="button" 
                class="p-2.5 rounded-lg text-gray-600 hover:text-brand-orange hover:bg-orange-50 focus:outline-none" 
                aria-label="Buka menu navigasi">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white px-4 pt-3 pb-6 shadow-xl">
    <div class="space-y-1">
      <a href="/" 
         class="block px-3 py-2.5 rounded-lg text-base font-semibold <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'text-brand-orange bg-orange-50' : 'text-gray-700 hover:text-brand-orange hover:bg-gray-50' %>">
        Home
      </a>
      <a href="/menu" 
         class="block px-3 py-2.5 rounded-lg text-base font-semibold <%= (typeof currentPath !== 'undefined' && currentPath === '/menu') ? 'text-brand-orange bg-orange-50' : 'text-gray-700 hover:text-brand-orange hover:bg-gray-50' %>">
        Katalog Jajanan &amp; Lapak PKL
      </a>
      <a href="/#ai-assistant" 
         class="block px-3 py-2.5 rounded-lg text-base font-semibold text-gray-700 hover:text-brand-orange hover:bg-gray-50">
        ✨ Asisten Rekomendasi AI
      </a>
      <a href="/#about" 
         class="block px-3 py-2.5 rounded-lg text-base font-semibold text-gray-700 hover:text-brand-orange hover:bg-gray-50">
        Tentang &amp; Problem Statement
      </a>
    </div>

    <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
      <span>M. Rio Aprilianto (20240140204)</span>
      <span class="font-bold text-brand-orange">PRD v1.0</span>
    </div>

    <div class="mt-3">
      <a href="/menu" 
         class="w-full flex items-center justify-center px-5 py-3 rounded-xl font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover shadow-md shadow-brand-orange/20">
        <span>Buka Katalog Jajanan PKL</span>
      </a>
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
