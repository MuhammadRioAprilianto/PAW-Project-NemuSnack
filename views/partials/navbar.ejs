<!-- Agency-Level Navbar NemuSnack with Multi-Role Authentication Support -->
<header class="sticky top-0 z-50 bg-[#FAF8F5]/90 backdrop-blur-md transition-all duration-300 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <div class="w-11 h-11 rounded-2xl bg-brand-orange flex items-center justify-center text-white shadow-lg shadow-brand-orange/30 group-hover:scale-105 transition-transform duration-200">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/>
          </svg>
        </div>
        <div>
          <span class="text-2xl font-black text-gray-900 tracking-tight flex items-center">
            Nemu<span class="text-brand-orange">Snack</span>
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-3">
        <a href="/" 
           class="px-3.5 py-2 rounded-full text-sm font-bold transition-all duration-200 <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'text-brand-orange bg-orange-100/60' : 'text-gray-700 hover:text-brand-orange hover:bg-orange-50' %>">
          Home
        </a>

        <a href="/menu" 
           class="px-3.5 py-2 rounded-full text-sm font-bold transition-all duration-200 <%= (typeof currentPath !== 'undefined' && currentPath === '/menu') ? 'text-brand-orange bg-orange-100/60' : 'text-gray-700 hover:text-brand-orange hover:bg-orange-50' %>">
          Katalog Jajanan
        </a>

        <a href="/#map-tracking" 
           class="px-3.5 py-2 rounded-full text-sm font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50 transition-all duration-200 flex items-center">
          <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse"></span>
          Peta Lapak
        </a>

        <a href="/#ai-assistant" 
           class="px-3.5 py-2 rounded-full text-sm font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50 transition-all duration-200 flex items-center">
          <span class="mr-1 text-xs">✨</span> Tanya AI
        </a>

        <!-- Tombol Cepat Buka Middleware Logger Console -->
        <button type="button" 
                onclick="toggleLoggerDrawer(true)"
                class="px-3 py-1.5 rounded-full text-xs font-black text-gray-800 bg-gray-100 hover:bg-brand-orange hover:text-white border border-gray-200 transition-all flex items-center space-x-1.5 shadow-sm"
                title="Buka Middleware Logger Console (GET, POST, PUT, DELETE)">
          <span class="text-brand-orange group-hover:text-white">⚡</span>
          <span>Logger API</span>
        </button>

        <!-- Link Khusus Role -->
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin/dashboard" 
               class="px-3.5 py-2 rounded-full text-sm font-black text-purple-700 bg-purple-100/80 hover:bg-purple-200 border border-purple-300 transition-all flex items-center">
              <span class="mr-1.5">🛡️</span> Admin Panel
            </a>
          <% } else if (currentUser.role === 'penjual') { %>
            <a href="/penjual/dashboard" 
               class="px-3.5 py-2 rounded-full text-sm font-black text-amber-800 bg-amber-100/80 hover:bg-amber-200 border border-amber-300 transition-all flex items-center">
              <span class="mr-1.5">🏪</span> Lapak Saya
            </a>
          <% } %>
        <% } %>
      </nav>

      <!-- Desktop Auth Section -->
      <div class="hidden md:flex items-center space-x-3">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <!-- Profile Badge -->
          <div class="flex items-center space-x-2.5 bg-white px-3 py-1.5 rounded-full border border-gray-200 shadow-sm">
            <div class="w-7 h-7 rounded-full bg-brand-orange text-white flex items-center justify-center font-black text-xs uppercase">
              <%= currentUser.name.charAt(0) %>
            </div>
            <div class="text-left pr-1">
              <p class="text-xs font-black text-gray-900 leading-tight truncate max-w-[120px]"><%= currentUser.name %></p>
              <p class="text-[10px] font-bold uppercase tracking-wider <%= currentUser.role === 'admin' ? 'text-purple-600' : (currentUser.role === 'penjual' ? 'text-amber-600' : 'text-emerald-600') %>">
                <%= currentUser.role %>
              </p>
            </div>
          </div>

          <!-- Tombol Logout -->
          <a href="/logout" 
             class="p-2 rounded-full text-gray-500 hover:text-red-600 hover:bg-red-50 transition-colors" 
             title="Keluar / Logout">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </a>
        <% } else { %>
          <!-- Belum Login -->
          <a href="/login" 
             class="px-5 py-2.5 rounded-full text-xs font-black text-gray-700 hover:text-brand-orange hover:bg-orange-50 border border-gray-200 transition-all">
            Masuk
          </a>
          <a href="/register" 
             class="px-5 py-2.5 rounded-full text-xs font-black text-white bg-brand-orange hover:bg-brand-orange-hover shadow-md shadow-brand-orange/20 transition-all">
            Daftar
          </a>
        <% } %>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden items-center space-x-2">
        <button id="mobile-menu-btn" 
                type="button" 
                class="p-2.5 rounded-full text-gray-700 hover:text-brand-orange hover:bg-orange-50 focus:outline-none" 
                aria-label="Buka menu navigasi">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-[#FAF8F5] px-4 pt-3 pb-6 shadow-xl">
    <div class="space-y-1.5">
      <a href="/" class="block px-4 py-2.5 rounded-2xl text-base font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50">
        Home
      </a>
      <a href="/menu" class="block px-4 py-2.5 rounded-2xl text-base font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50">
        Katalog Jajanan
      </a>
      <a href="/#map-tracking" class="block px-4 py-2.5 rounded-2xl text-base font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50 flex items-center">
        <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse"></span>
        Peta Lapak
      </a>
      <a href="/#ai-assistant" class="block px-4 py-2.5 rounded-2xl text-base font-bold text-gray-700 hover:text-brand-orange hover:bg-orange-50">
        ✨ Tanya AI
      </a>
      <button type="button" 
              onclick="toggleLoggerDrawer(true)"
              class="w-full text-left px-4 py-2.5 rounded-2xl text-base font-bold text-gray-900 bg-orange-100/60 hover:bg-orange-100 flex items-center space-x-2">
        <span>⚡ Middleware Logger (GET/POST/PUT/DEL)</span>
      </button>

      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin/dashboard" class="block px-4 py-2.5 rounded-2xl text-base font-black text-purple-700 bg-purple-50">
            🛡️ Admin Panel
          </a>
        <% } else if (currentUser.role === 'penjual') { %>
          <a href="/penjual/dashboard" class="block px-4 py-2.5 rounded-2xl text-base font-black text-amber-800 bg-amber-50">
            🏪 Dashboard Lapak Penjual
          </a>
        <% } %>
      <% } %>
    </div>

    <div class="mt-4 pt-3 border-t border-gray-200">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="flex items-center justify-between px-3 py-2 bg-white rounded-2xl mb-3">
          <div>
            <p class="text-sm font-extrabold text-gray-900"><%= currentUser.name %></p>
            <p class="text-xs text-gray-500 uppercase"><%= currentUser.role %></p>
          </div>
          <a href="/logout" class="text-xs font-bold text-red-600 hover:underline">Keluar</a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-2 gap-2">
          <a href="/login" class="flex items-center justify-center py-2.5 rounded-full font-bold text-xs text-gray-700 bg-gray-100 hover:bg-gray-200">
            Masuk
          </a>
          <a href="/register" class="flex items-center justify-center py-2.5 rounded-full font-bold text-xs text-white bg-brand-orange hover:bg-brand-orange-hover">
            Daftar
          </a>
        </div>
      <% } %>
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });
  }
</script>
