<div id="logger-dock-tab" class="fixed right-0 top-1/2 -translate-y-1/2 z-40">
  <button type="button" onclick="toggleLoggerDrawer(true)" aria-label="Buka riwayat aktivitas" title="Riwayat aktivitas"
          class="group flex items-center gap-2 bg-gray-900 hover:bg-gray-800 text-white pl-3 pr-3 py-3 rounded-l-xl border-l-2 border-y border-brand-orange shadow-lg transition-colors focus:outline-none focus:ring-2 focus:ring-brand-orange">
    <span class="w-2 h-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
    <span class="text-xs font-bold">Aktivitas</span>
    <svg class="w-4 h-4 text-gray-300 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </button>
</div>

<div id="logger-drawer-backdrop" onclick="toggleLoggerDrawer(false)" class="fixed inset-0 bg-gray-900/40 backdrop-blur-[1px] z-50 opacity-0 pointer-events-none transition-opacity duration-200"></div>

<aside id="logger-drawer-panel" aria-label="Riwayat aktivitas" aria-hidden="true"
       class="fixed top-0 right-0 h-full w-full sm:w-[520px] max-w-full z-50 bg-[#FAF8F5] text-gray-900 shadow-2xl border-l border-gray-200 flex flex-col translate-x-full transition-transform duration-200 ease-out">
  <header class="px-5 py-4 bg-white border-b border-gray-200 flex items-center justify-between shrink-0">
    <div>
      <h2 class="text-lg font-bold text-gray-900">Riwayat aktivitas</h2>
      <p class="text-xs text-gray-500 mt-0.5">Aksi yang dilakukan di NemuSnack</p>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" onclick="fetchLoggerRecentLogs()" class="px-3 py-2 rounded-lg text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 transition-colors">Muat ulang</button>
      <button type="button" onclick="toggleLoggerDrawer(false)" aria-label="Tutup riwayat aktivitas" class="p-2 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </header>

  <div class="px-5 py-3 bg-white border-b border-gray-100 flex items-center justify-between text-xs text-gray-500">
    <span id="logger-updated-at">Memuat aktivitas terbaru</span>

  </div>
  <div id="logger-logs-list" class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-3" aria-live="polite">
    <div class="rounded-xl bg-white border border-gray-100 p-5 text-sm text-gray-500 text-center">Memuat aktivitas terbaru...</div>
  </div>
</aside>

<script>
  let loggerRefreshTimer = null;
  const loggerMethodStyles = {
    GET: 'bg-sky-50 text-sky-700 border-sky-200',
    POST: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    PUT: 'bg-amber-50 text-amber-800 border-amber-200',
    PATCH: 'bg-violet-50 text-violet-700 border-violet-200',
    DELETE: 'bg-rose-50 text-rose-700 border-rose-200'
  };

  function toggleLoggerDrawer(shouldOpen) {
    const panel = document.getElementById('logger-drawer-panel');
    const backdrop = document.getElementById('logger-drawer-backdrop');
    if (!panel || !backdrop) return;

    panel.classList.toggle('translate-x-full', !shouldOpen);
    panel.setAttribute('aria-hidden', String(!shouldOpen));
    backdrop.classList.toggle('opacity-0', !shouldOpen);
    backdrop.classList.toggle('pointer-events-none', !shouldOpen);
    document.body.classList.toggle('overflow-hidden', shouldOpen);

    if (shouldOpen) {
      fetchLoggerRecentLogs();
      if (loggerRefreshTimer) clearInterval(loggerRefreshTimer);
      loggerRefreshTimer = setInterval(fetchLoggerRecentLogs, 15000);
    } else if (loggerRefreshTimer) {
      clearInterval(loggerRefreshTimer);
      loggerRefreshTimer = null;
    }
  }

  function escapeLoggerText(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, character => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[character]);
  }

  function parseLoggerValue(value) {
    if (typeof value !== 'string') return value;
    try { return JSON.parse(value); } catch (_) { return value; }
  }

  function loggerDetails(log) {
    const payload = parseLoggerValue(log.request_payload) || {};
    const response = parseLoggerValue(log.response_data) || {};
    const data = response.data || response.product || {};
    const fields = [
      ['name', 'Nama'], ['product_name', 'Nama'], ['shop_name', 'Lapak'],
      ['price', 'Harga'], ['category', 'Kategori'], ['status', 'Status'],
      ['location', 'Lokasi'], ['latitude', 'Latitude'], ['longitude', 'Longitude'],
      ['lat', 'Latitude'], ['lng', 'Longitude'],
      ['route', 'Rute'], ['rating', 'Rating'], ['comment', 'Ulasan'],
      ['message', 'Pesan'], ['q', 'Pencarian'], ['search', 'Pencarian']
    ];
    const details = [];
    fields.forEach(([key, label]) => {
      const value = payload[key];
      if (value !== undefined && value !== null && String(value).trim() !== '') {
        details.push(`${label}: ${String(value).trim()}`);
      }
    });
    const resultName = data.name || data.shop_name || data.product_name;
    if (resultName && !details.some(item => item.includes(String(resultName)))) details.push(`Data: ${resultName}`);
    let message = response.message || response.success_message;
    if (response.redirect && response.targetUrl) {
      try {
        const redirectUrl = new URL(response.targetUrl, window.location.origin);
        const flashMessage = redirectUrl.searchParams.get('msg');
        if (flashMessage) message = flashMessage;
      } catch (_) {}
    }
    if (message && !details.includes(message)) details.push(message);
    if (details.length) return details.slice(0, 5).join(' · ');
    if (payload.info) return '';
    return log.method === 'GET' ? 'Data berhasil dimuat.' : '';
  }

  function renderLoggerEntries(entries) {
    const list = document.getElementById('logger-logs-list');
    if (!list) return;
    const activityCount = document.getElementById('logger-activity-count');
    const updatedAt = document.getElementById('logger-updated-at');
    if (activityCount) activityCount.textContent = `${entries.length} aktivitas`;
    if (updatedAt) updatedAt.textContent = `Diperbarui ${new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })}`;

    if (!entries.length) {
      list.innerHTML = '<div class="rounded-xl bg-white border border-gray-100 p-8 text-sm text-gray-500 text-center">Belum ada aktivitas yang tercatat.</div>';
      return;
    }

    list.innerHTML = entries.map(log => {
      const method = String(log.method || 'GET').toUpperCase();
      const methodClass = loggerMethodStyles[method] || 'bg-gray-100 text-gray-700 border-gray-200';
      const status = Number(log.status_code || log.statusCode || 0);
      const statusClass = status >= 400 ? 'text-rose-700 bg-rose-50' : status >= 300 ? 'text-amber-800 bg-amber-50' : 'text-emerald-700 bg-emerald-50';
      const timestamp = log.created_at || log.timestamp;
      const time = timestamp ? new Date(timestamp).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : '';
      const path = escapeLoggerText(log.path || '');
      const action = escapeLoggerText(log.action || `${method} ${log.path || ''}`);
      const details = escapeLoggerText(loggerDetails(log));
      const duration = Number(log.duration || 0);
      return `<article class="rounded-xl bg-white border border-gray-200 p-4 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <div class="flex items-center flex-wrap gap-2">
              <span class="px-2 py-1 rounded-md border text-[11px] font-bold ${methodClass}">${escapeLoggerText(method)}</span>
              <h3 class="text-sm font-bold text-gray-900">${action}</h3>
            </div>
            <p class="mt-2 text-xs text-gray-500 break-all">${path}</p>
          </div>
          <span class="shrink-0 px-2 py-1 rounded-md text-xs font-bold ${statusClass}">${status || '—'}</span>
        </div>
        ${details ? `<p class="mt-3 text-sm text-gray-700 leading-relaxed break-words">${details}</p>` : ''}
        <div class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between gap-2 text-[11px] text-gray-400">
          <time>${escapeLoggerText(time)}</time><span>${duration} ms</span>
        </div>
      </article>`;
    }).join('');
  }

  async function fetchLoggerRecentLogs() {
    const list = document.getElementById('logger-logs-list');
    if (!list) return;
    try {
      const response = await fetch('/api/logs?limit=50', { headers: { Accept: 'application/json' } });
      const result = await response.json();
      if (!response.ok || !result.success || !Array.isArray(result.data)) throw new Error('Riwayat aktivitas tidak dapat dimuat.');
      renderLoggerEntries(result.data);
    } catch (error) {
      list.innerHTML = `<div class="rounded-xl bg-white border border-rose-200 p-5 text-sm text-rose-700 text-center">${escapeLoggerText(error.message || 'Gagal memuat aktivitas.')}</div>`;
    }
  }

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') toggleLoggerDrawer(false);
  });
</script>
