<div class="image-upload-widget md:col-span-2" data-image-upload>
  <label class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5" for="<%= uploadId %>"><%= uploadLabel || 'Foto Produk' %></label>
  <div class="grid grid-cols-1 sm:grid-cols-[1fr_12rem] gap-4 items-center">
    <label for="<%= uploadId %>" data-dropzone class="min-h-36 rounded-2xl border-2 border-dashed border-orange-200 bg-orange-50/40 px-5 py-6 flex flex-col items-center justify-center text-center cursor-pointer hover:border-brand-orange hover:bg-orange-50 transition-colors">
      <input id="<%= uploadId %>" type="file" name="image" accept="image/jpeg,image/png,image/webp" class="sr-only" data-image-input>
      <span class="text-2xl mb-1">📷</span>
      <span class="inline-flex px-4 py-2 rounded-full bg-brand-orange text-white text-xs font-black shadow-sm">Choose File</span>
      <span class="text-[11px] text-gray-500 mt-1">atau seret gambar ke area ini · JPG, PNG, WEBP · maks. 5 MB</span>
      <span class="text-[11px] font-bold text-brand-orange mt-2" data-file-name>Pilih gambar produk</span>
    </label>
    <div class="text-center">
      <p class="text-[11px] font-black uppercase tracking-wide text-gray-500 mb-2">Pratinjau</p>
      <img src="<%= currentImage || '/assets/images/snack-placeholder.svg' %>" alt="Pratinjau gambar produk" data-image-preview class="w-full h-36 rounded-2xl object-cover border border-gray-200 bg-white" onerror="this.onerror=null;this.src='/assets/images/snack-placeholder.svg'">
    </div>
  </div>
</div>
