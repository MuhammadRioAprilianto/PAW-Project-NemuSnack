<section class="py-14 bg-[#FAF8F5] min-h-[70vh]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <span class="inline-flex px-4 py-1.5 rounded-full bg-orange-100 text-brand-orange text-xs font-black tracking-wide">DIREKTORI PEDAGANG</span>
      <h1 class="mt-4 text-3xl sm:text-5xl font-black tracking-tight text-gray-900">Lapak / PKL</h1>
      <p class="mt-3 text-sm sm:text-base text-gray-600">Kenali pedagang, cek menu, rating, status, dan lokasi lapaknya.</p>
      <form action="/lapak" method="GET" class="mt-6 flex gap-2 max-w-xl mx-auto">
        <input type="search" name="q" value="<%= query %>" placeholder="Cari nama lapak, kategori, atau lokasi" class="min-w-0 flex-1 px-5 py-3 rounded-full border border-gray-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange">
        <button class="px-6 py-3 rounded-full bg-brand-orange text-white text-sm font-black hover:bg-brand-orange-hover">Cari</button>
      </form>
    </div>

    <% if (sellers.length) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% sellers.forEach(seller => { %>
          <article class="bg-white rounded-3xl border border-gray-100 shadow-card overflow-hidden flex flex-col">
            <img src="<%= seller.shop_image %>" alt="Foto <%= seller.shop_name %>" class="w-full h-48 object-cover bg-gray-100" onerror="this.onerror=null;this.src='/assets/images/hero-nemusnack.jpg'">
            <div class="p-5 flex-1 flex flex-col">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h2 class="text-lg font-black text-gray-900"><%= seller.shop_name %></h2>
                  <p class="text-xs text-gray-500 mt-1">Pedagang: <%= seller.name %></p>
                </div>
                <% if (seller.seller_status === 'Mangkal') { %>
                  <span class="shrink-0 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-[11px] font-black">Mangkal</span>
                <% } else if (seller.seller_status === 'Sedang Berjalan' || seller.seller_status === 'Berjalan') { %>
                  <span class="shrink-0 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-[11px] font-black">Berjalan</span>
                <% } else if (seller.seller_status === 'Libur') { %>
                  <span class="shrink-0 px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-[11px] font-black">Libur</span>
                <% } else { %>
                  <span class="shrink-0 px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-[11px] font-black">Tutup</span>
                <% } %>
              </div>
              <p class="mt-3 text-sm text-gray-600 line-clamp-3"><%= seller.shop_description || 'Pedagang jajanan mitra NemuSnack.' %></p>
              <div class="mt-4 flex items-center justify-between text-xs">
                <span class="text-amber-600 font-extrabold"><%= seller.rating > 0 ? `★ ${Number(seller.rating).toFixed(1)} / 5` : 'Belum ada rating' %></span>
                <span class="text-gray-500"><%= seller.reviewsCount %> ulasan · <%= seller.productCount %> menu</span>
              </div>
              <div class="mt-3 flex flex-wrap gap-1.5">
                <% (seller.categories || []).slice(0, 3).forEach(category => { %>
                  <span class="px-2.5 py-1 rounded-full bg-orange-50 text-orange-800 text-[10px] font-bold"><%= category %></span>
                <% }); %>
              </div>
              <p class="mt-4 text-xs text-gray-500"> <%= seller.seller_location %></p>
              <a href="/lapak/<%= seller.id %>" class="mt-5 w-full text-center px-5 py-3 rounded-full bg-gray-900 text-white text-xs font-black hover:bg-brand-orange transition-colors">Lihat Profil &amp; Katalog</a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <div class="max-w-xl mx-auto text-center py-14 px-6 rounded-3xl bg-white border border-gray-100">

        <h2 class="mt-3 text-lg font-black text-gray-900">Lapak tidak ditemukan</h2>
        <p class="mt-1 text-sm text-gray-500">Coba kata kunci lain atau lihat seluruh pedagang.</p>
        <a href="/lapak" class="inline-flex mt-5 px-5 py-2.5 rounded-full bg-brand-orange text-white text-xs font-black">Tampilkan Semua</a>
      </div>
    <% } %>
  </div>
</section>
