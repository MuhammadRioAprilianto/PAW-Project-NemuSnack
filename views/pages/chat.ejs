<!-- Halaman Penuh AI Assistant Chatbot - NemuSnack -->
<div class="py-10 bg-[#FAF8F5] min-h-[calc(100vh-200px)]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Breadcrumb & Header Title -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <nav class="flex items-center space-x-2 text-xs font-bold text-gray-400 mb-1">
          <a href="/" class="hover:text-brand-orange transition-colors">Beranda</a>
          <span>/</span>
          <span class="text-brand-orange">AI Assistant Chatbot</span>
        </nav>
        <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
          Tanya Asisten NemuSnack
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">
          Konsultasikan jajanan favoritmu, tanyakan harga, rekomendasi rasa, hingga lapak PKL mangkal secara real-time.
        </p>
      </div>

      <div class="flex items-center space-x-2">
        <a href="/menu" class="px-4 py-2 rounded-full text-xs font-bold bg-white text-gray-700 border border-gray-200 hover:bg-gray-50 shadow-sm transition-all">
          Lihat Semua Menu
        </a>
      </div>
    </div>

    <!-- Chat Card Component -->
    <div class="bg-white rounded-[2.5rem] border border-gray-100 shadow-xl overflow-hidden">

      <!-- Chatbot Header Banner -->
      <div class="bg-gradient-to-r from-brand-orange via-orange-500 to-amber-500 p-6 sm:p-7 text-white">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-2xl shadow-inner border border-white/30 shrink-0">
              N
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <h2 class="text-lg sm:text-xl font-black tracking-tight">Asisten NemuSnack</h2>
              </div>
              <p class="text-xs text-white/90 mt-0.5">
                Temukan informasi jajanan dan lapak di sekitarmu.
              </p>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <button onclick="clearChatHistory()" type="button" class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold border border-white/20 transition-all flex items-center space-x-1.5">
              <span>Reset Percakapan</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Suggestion Pills -->
      <div class="p-4 sm:px-6 bg-orange-50/40 border-b border-gray-100">
        <p class="text-[11px] font-extrabold text-gray-500 uppercase tracking-wider mb-2">Pertanyaan Populer:</p>
        <div class="flex flex-wrap gap-2">
          <button type="button" onclick="askAiPrompt('Apa saja produk yang tersedia di aplikasi ini?')" class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-brand-orange hover:text-white text-gray-700 border border-gray-200 shadow-sm transition-all">
            Apa saja produk yang tersedia?
          </button>
          <button type="button" onclick="askAiPrompt('Rekomendasikan jajanan manis lumer sore ini')" class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-brand-orange hover:text-white text-gray-700 border border-gray-200 shadow-sm transition-all">
            Jajanan manis lumer
          </button>
          <button type="button" onclick="askAiPrompt('Jajanan apa yang paling murah di bawah 12 ribu?')" class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-brand-orange hover:text-white text-gray-700 border border-gray-200 shadow-sm transition-all">
            Jajanan murah &lt; Rp12.000
          </button>
          <button type="button" onclick="askAiPrompt('Rekomendasikan camilan pedas dan gurih')" class="px-3 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-brand-orange hover:text-white text-gray-700 border border-gray-200 shadow-sm transition-all">
            Camilan pedas gurih
          </button>
        </div>
      </div>

      <!-- Chat Messages Scrollable Box -->
      <div id="ai-chat-messages" class="p-6 sm:p-8 space-y-4 max-h-[460px] min-h-[340px] overflow-y-auto bg-[#FAF8F5]/60 flex flex-col">
        <!-- Initial Greeting Message -->
        <div class="flex items-start space-x-3 max-w-[85%] self-start">
          <div class="w-8 h-8 rounded-full bg-brand-orange text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm">
            N
          </div>
          <div class="bg-white p-4 rounded-2xl rounded-tl-none border border-gray-100 shadow-sm text-sm text-gray-800 leading-relaxed">
            <p class="font-bold text-brand-orange text-xs mb-1">Asisten NemuSnack</p>
            <p>Halo! Saya dapat membantu menemukan jajanan berdasarkan harga, jenis, lokasi, dan status lapak. Apa yang sedang Anda cari?</p>
          </div>
        </div>
      </div>

      <!-- Error Alert Box -->
      <div id="ai-error-box" class="hidden mx-6 sm:mx-8 mb-4 p-4 rounded-2xl bg-red-50 border border-red-200 text-xs text-red-700 flex items-start space-x-2.5">
        <span class="text-base">!</span>
        <div class="flex-1">
          <strong class="font-bold block mb-0.5">Pemberitahuan Layanan AI:</strong>
          <span id="ai-error-message">Asisten sedang mengalami kendala. Silakan coba kembali.</span>
        </div>
        <button onclick="dismissAiError()" type="button" class="text-red-400 hover:text-red-700 font-bold ml-2">✕</button>
      </div>

      <!-- Input Form -->
      <div class="p-4 sm:p-6 bg-white border-t border-gray-100">
        <form id="ai-chat-form" onsubmit="handleAiChatSubmit(event)" class="relative">
          <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
            <div class="relative flex-grow">
              <input type="text" 
                     id="ai-user-query" 
                     name="message"
                     maxlength="500"
                     autocomplete="off"
                     placeholder="Tanyakan rekomendasi jajanan, harga, rasa, atau lapak PKL..." 
                     class="w-full px-5 py-3.5 pr-14 rounded-2xl sm:rounded-full border border-gray-200 focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 text-sm outline-none transition-all placeholder:text-gray-400">
              <span id="ai-char-counter" class="absolute right-4 top-1/2 -translate-y-1/2 text-[10px] font-semibold text-gray-400 pointer-events-none">
                0/500
              </span>
            </div>
            <button type="submit" 
                    id="ai-send-button"
                    class="px-7 py-3.5 rounded-2xl sm:rounded-full font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover disabled:bg-gray-300 disabled:cursor-not-allowed shadow-lg shadow-brand-orange/20 transition-all flex items-center justify-center space-x-2 shrink-0">
              <span id="ai-btn-text">Kirim</span>
              <span id="ai-btn-icon">➤</span>
            </button>
          </div>
          <div class="mt-2.5 flex items-center justify-end text-[11px] text-gray-400 px-2">
            <span class="italic">Maks. 500 karakter</span>
          </div>
        </form>
      </div>

    </div>

  </div>
</div>

<!-- Script Logika Frontend AI Assistant Chatbot -->
<script>
  const chatMessagesContainer = document.getElementById('ai-chat-messages');
  const chatInput = document.getElementById('ai-user-query');
  const sendButton = document.getElementById('ai-send-button');
  const btnText = document.getElementById('ai-btn-text');
  const btnIcon = document.getElementById('ai-btn-icon');
  const charCounter = document.getElementById('ai-char-counter');
  const errorBox = document.getElementById('ai-error-box');
  const errorMessage = document.getElementById('ai-error-message');

  // Update counter karakter
  if (chatInput && charCounter) {
    chatInput.addEventListener('input', () => {
      const len = chatInput.value.length;
      charCounter.textContent = `${len}/500`;
      if (len >= 480) {
        charCounter.classList.add('text-red-500', 'font-bold');
      } else {
        charCounter.classList.remove('text-red-500', 'font-bold');
      }
    });
  }

  // Format teks respons AI (markdown sederhana: bold, list, newline, harga)
  function formatAiMarkdown(text) {
    if (!text) return '';
    let escaped = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // Bold **teks**
    escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

    // List item (* atau - di awal baris)
    escaped = escaped.replace(/^[*-]\s+(.+)$/gm, '<li class="ml-4 list-disc">$1</li>');

    // Baris baru
    escaped = escaped.replace(/\n/g, '<br/>');

    return escaped;
  }

  // Waktu saat ini
  function getCurrentTimeString() {
    const now = new Date();
    return now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
  }

  // Menambahkan bubble pesan ke dalam chat
  function appendMessageBubble(sender, text, isError = false) {
    const timeStr = getCurrentTimeString();
    const bubbleWrapper = document.createElement('div');

    if (sender === 'user') {
      bubbleWrapper.className = 'flex items-start space-x-3 max-w-[85%] self-end flex-row-reverse space-x-reverse';
      bubbleWrapper.innerHTML = `
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-brand-orange to-amber-500 text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm">
          K
        </div>
        <div>
          <div class="bg-brand-orange text-white p-4 rounded-2xl rounded-tr-none shadow-sm text-sm leading-relaxed">
            ${formatAiMarkdown(text)}
          </div>
          <span class="block text-[10px] text-gray-400 mt-1 text-right">${timeStr} • Kamu</span>
        </div>
      `;
    } else {
      bubbleWrapper.className = 'flex items-start space-x-3 max-w-[85%] self-start';
      const bgClass = isError ? 'bg-red-50 border-red-200 text-red-800' : 'bg-white border-gray-100 text-gray-800';
      bubbleWrapper.innerHTML = `
        <div class="w-8 h-8 rounded-full ${isError ? 'bg-red-500' : 'bg-brand-orange'} text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm">
          ${isError ? '!' : 'N'}
        </div>
        <div>
          <div class="${bgClass} p-4 rounded-2xl rounded-tl-none border shadow-sm text-sm leading-relaxed">
            <p class="font-bold text-xs mb-1 ${isError ? 'text-red-600' : 'text-brand-orange'}">
              Asisten NemuSnack${isError ? ' · Peringatan' : ''}
            </p>
            <div>${formatAiMarkdown(text)}</div>
          </div>
          <span class="block text-[10px] text-gray-400 mt-1">${timeStr} • Asisten</span>
        </div>
      `;
    }

    chatMessagesContainer.appendChild(bubbleWrapper);
    chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
  }

  // Menampilkan indikator loading (typing animation)
  function showLoadingIndicator() {
    const loadingElem = document.createElement('div');
    loadingElem.id = 'ai-typing-indicator';
    loadingElem.className = 'flex items-start space-x-3 max-w-[85%] self-start';
    loadingElem.innerHTML = `
      <div class="w-8 h-8 rounded-full bg-brand-orange text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm animate-spin">
        N
      </div>
      <div class="bg-white p-4 rounded-2xl rounded-tl-none border border-gray-100 shadow-sm text-sm text-gray-500 flex items-center space-x-2">
        <span class="font-bold text-brand-orange text-xs">AI sedang berpikir</span>
        <span class="flex space-x-1">
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-bounce"></span>
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-bounce [animation-delay:0.2s]"></span>
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-bounce [animation-delay:0.4s]"></span>
        </span>
      </div>
    `;
    chatMessagesContainer.appendChild(loadingElem);
    chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
  }

  // Menghapus indikator loading
  function removeLoadingIndicator() {
    const loadingElem = document.getElementById('ai-typing-indicator');
    if (loadingElem) {
      loadingElem.remove();
    }
  }

  // Tampilkan peringatan error
  function showAiError(msg) {
    if (errorBox && errorMessage) {
      errorMessage.textContent = msg;
      errorBox.classList.remove('hidden');
    }
  }

  function dismissAiError() {
    if (errorBox) {
      errorBox.classList.add('hidden');
    }
  }

  // Kirim prompt dari tombol saran
  async function askAiPrompt(promptText) {
    if (!promptText) return;
    chatInput.value = promptText;
    if (charCounter) charCounter.textContent = `${promptText.length}/500`;
    await submitChatMessage(promptText);
  }

  // Handle form submit
  async function handleAiChatSubmit(e) {
    e.preventDefault();
    const query = chatInput.value.trim();
    if (!query) return;
    await submitChatMessage(query);
  }

  // Kirim pesan chat via Fetch API ke backend POST /api/chat
  async function submitChatMessage(messageText) {
    dismissAiError();

    // 1. Tampilkan bubble pesan pengguna
    appendMessageBubble('user', messageText);
    chatInput.value = '';
    if (charCounter) charCounter.textContent = '0/500';

    // 2. Set state loading pada tombol dan input
    sendButton.disabled = true;
    chatInput.disabled = true;
    btnText.textContent = 'Memproses...';
    btnIcon.textContent = '⏳';

    showLoadingIndicator();

    try {
      // 3. Kirim permintaan ke backend Express.js (POST /api/chat)
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ message: messageText })
      });

      const result = await response.json();
      removeLoadingIndicator();

      if (!response.ok || !result.success) {
        const errMsg = result.message || 'Asisten sedang mengalami kendala. Silakan coba kembali nanti.';
        appendMessageBubble('ai', `! ${errMsg}`, true);
        showAiError(errMsg);
        return;
      }

      // 4. Tampilkan balasan asisten NemuSnack
      const reply = result.data && result.data.reply ? result.data.reply : 'Maaf, tidak ada balasan dari sistem.';
      appendMessageBubble('ai', reply);

    } catch (err) {
      console.error('Chat error:', err);
      removeLoadingIndicator();
      const failMsg = 'Gagal terhubung ke server backend. Pastikan server aktif dan koneksi internet stabil.';
      appendMessageBubble('ai', `! ${failMsg}`, true);
      showAiError(failMsg);
    } finally {
      // 5. Kembalikan state normal pada tombol dan input
      sendButton.disabled = false;
      chatInput.disabled = false;
      btnText.textContent = 'Kirim';
      btnIcon.textContent = '➤';
      chatInput.focus();
    }
  }

  // Bersihkan riwayat chat
  function clearChatHistory() {
    chatMessagesContainer.innerHTML = `
      <div class="flex items-start space-x-3 max-w-[85%] self-start">
        <div class="w-8 h-8 rounded-full bg-brand-orange text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm">
          N
        </div>
        <div class="bg-white p-4 rounded-2xl rounded-tl-none border border-gray-100 shadow-sm text-sm text-gray-800 leading-relaxed">
          <p class="font-bold text-brand-orange text-xs mb-1">Asisten NemuSnack</p>
          <p>Percakapan telah direset. Ada jajanan kaki lima lainnya yang ingin kamu tanyakan?</p>
        </div>
      </div>
    `;
    dismissAiError();
  }
</script>
