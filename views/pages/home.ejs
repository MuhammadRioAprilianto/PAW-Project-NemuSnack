<!-- SCRIPT PETA INTERAKTIF & AI REKOMENDASI -->
<script>
  let mapInstance = null;
  let mapMarkers = [];
  const vendorsData = <%- JSON.stringify(products) %>;

  // Inisialisasi Peta Leaflet.js
  function initTrackingMap() {
    const mapContainer = document.getElementById('tracking-map');
    if (!mapContainer || mapInstance) return;

    // Koordinat pusat peta di sekitar area kuliner kampus
    mapInstance = L.map('tracking-map').setView([-7.766, 110.380], 15);

    // Tile Layer OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap contributors'
    }).addTo(mapInstance);

    // Render Markers untuk setiap vendor
    renderVendorMarkers(vendorsData);
  }

  function renderVendorMarkers(data) {
    // Bersihkan marker lama
    mapMarkers.forEach(m => mapInstance.removeLayer(m));
    mapMarkers = [];

    data.forEach(vendor => {
      if (!vendor.lat || !vendor.lng) return;

      const isMangkal = vendor.status === 'Mangkal';
      const markerColor = isMangkal ? '#10B981' : '#F59E0B';
      const statusIcon = isMangkal ? '📍' : '🚶';

      // Custom HTML Marker Icon
      const customIcon = L.divIcon({
        className: 'custom-vendor-marker',
        html: `
          <div style="background-color: ${markerColor}; width: 34px; height: 34px; border-radius: 50%; border: 3px solid white; box-shadow: 0 4px 10px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; font-size: 14px;">
            ${statusIcon}
          </div>
        `,
        iconSize: [34, 34],
        iconAnchor: [17, 34],
        popupAnchor: [0, -32]
      });

      const marker = L.marker([vendor.lat, vendor.lng], { icon: customIcon }).addTo(mapInstance);

      // Popup Content (Agency Card Style)
      const popupHtml = `
        <div style="min-width: 220px; font-family: 'Plus Jakarta Sans', sans-serif;">
          <img src="${vendor.image}" style="width: 100%; height: 110px; object-fit: cover; border-radius: 12px; margin-bottom: 8px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <span style="font-size: 10px; font-weight: 800; color: ${markerColor}; background: rgba(0,0,0,0.05); padding: 2px 8px; border-radius: 20px;">
              ${vendor.status}
            </span>
            <span style="font-size: 11px; font-weight: 800; color: #F59E0B;">★ ${vendor.rating}</span>
          </div>
          <h4 style="font-size: 14px; font-weight: 800; margin: 0 0 2px 0; color: #111827;">${vendor.name}</h4>
          <p style="font-size: 11px; color: #6B7280; margin: 0 0 6px 0;">📍 ${vendor.location}</p>
          <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #F3F4F6; padding-top: 6px;">
            <span style="font-size: 13px; font-weight: 900; color: #FF532A;">Rp ${vendor.price.toLocaleString('id-ID')}</span>
            <a href="/menu?id=${vendor.id}" style="font-size: 11px; font-weight: 800; color: white; background: #FF532A; padding: 4px 12px; border-radius: 20px; text-decoration: none;">
              Detail
            </a>
          </div>
        </div>
      `;

      marker.bindPopup(popupHtml);
      marker.vendorData = vendor;
      mapMarkers.push(marker);
    });
  }

  // Filter Marker di Peta
  function filterMapMarkers(status) {
    document.querySelectorAll('#btn-filter-all, #btn-filter-mangkal, #btn-filter-jalan').forEach(btn => {
      btn.className = 'px-4 py-1.5 rounded-full text-xs font-bold text-gray-600 hover:text-brand-orange transition-all';
    });

    if (status === 'all') {
      document.getElementById('btn-filter-all').className = 'px-4 py-1.5 rounded-full text-xs font-black bg-brand-orange text-white shadow-sm transition-all';
      renderVendorMarkers(vendorsData);
    } else {
      const filtered = vendorsData.filter(v => v.status === status);
      if (status === 'Mangkal') {
        document.getElementById('btn-filter-mangkal').className = 'px-4 py-1.5 rounded-full text-xs font-black bg-emerald-500 text-white shadow-sm transition-all';
      } else {
        document.getElementById('btn-filter-jalan').className = 'px-4 py-1.5 rounded-full text-xs font-black bg-amber-500 text-white shadow-sm transition-all';
      }
      renderVendorMarkers(filtered);
    }
  }

  // AI Assistant Functions
  async function askAiPrompt(query) {
    document.getElementById('ai-user-query').value = query;
    await executeAiQuery(query);
  }

  async function handleAiSubmit(e) {
    e.preventDefault();
    const query = document.getElementById('ai-user-query').value.trim();
    if (!query) return;
    await executeAiQuery(query);
  }

  async function executeAiQuery(query) {
    const resultBox = document.getElementById('ai-result-content');
    resultBox.innerHTML = `<p class="text-brand-orange font-bold animate-pulse">✨ Menganalisis rekomendasi jajanan terbaik...</p>`;

    try {
      const response = await fetch(`/api/rekomendasi?q=${encodeURIComponent(query)}`);
      const data = await response.json();

      if (data.recommendations && data.recommendations.length > 0) {
        let html = `<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4 text-left">`;
        data.recommendations.forEach(item => {
          html += `
            <div class="p-4 bg-orange-50/50 rounded-2xl border border-orange-100 flex items-center space-x-3">
              <img src="${item.image}" class="w-14 h-14 rounded-xl object-cover">
              <div class="flex-1 min-w-0">
                <h5 class="text-sm font-extrabold text-gray-900 truncate">${item.name}</h5>
                <p class="text-xs text-gray-500">📍 ${item.location}</p>
                <p class="text-xs font-black text-brand-orange mt-0.5">Rp ${item.price.toLocaleString('id-ID')}</p>
              </div>
              <a href="/menu?id=${item.id}" class="px-3 py-1.5 rounded-full bg-brand-orange text-white text-xs font-bold hover:bg-brand-orange-hover shrink-0">
                Lihat
              </a>
            </div>
          `;
        });
        html += `</div>`;
        resultBox.innerHTML = html;
      } else {
        resultBox.innerHTML = `<p class="text-gray-500">Tidak ada jajanan yang cocok. Coba cari "manis" atau "pedas".</p>`;
      }
    } catch (err) {
      console.error(err);
      resultBox.innerHTML = `<p class="text-red-500">Gagal memuat rekomendasi.</p>`;
    }
  }

  // Load Map saat DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    initTrackingMap();
  });
</script>
