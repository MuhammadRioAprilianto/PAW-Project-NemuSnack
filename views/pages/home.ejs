<!-- SCRIPT PETA INTERAKTIF & AI REKOMENDASI -->
<script>
  let mapInstance = null;
  let mapLayers = [];
  let vendorsData = <%- JSON.stringify(activeSellers).replace(/</g, '\\u003c') %>;
  let currentMapFilter = 'all';

  // Inisialisasi Peta Leaflet.js
  function initTrackingMap() {
    const mapContainer = document.getElementById('tracking-map');
    if (!mapContainer || mapInstance) return;

    // Koordinat pusat peta di sekitar area kuliner kampus
    mapInstance = L.map('tracking-map').setView([-7.766, 110.380], 15);

    // Tile Layer OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap contributors'
    }).addTo(mapInstance);

    // Satu marker untuk setiap pedagang yang sedang beroperasi.
    renderVendorMarkers(vendorsData);
    window.setInterval(refreshVendorMarkers, 20000);
  }

  function escapePopupText(value) {
    return String(value || '').replace(/[&<>"']/g, char => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[char]);
  }

  function renderVendorMarkers(data) {
    mapLayers.forEach(layer => mapInstance.removeLayer(layer));
    mapLayers = [];

    data.forEach(vendor => {
      if (!vendor.lat || !vendor.lng) return;

      const isMangkal = vendor.seller_status === 'Mangkal';
      const markerColor = isMangkal ? '#10B981' : '#F59E0B';
      const statusIcon = '•';

      // Custom HTML Marker Icon
      const customIcon = L.divIcon({
        className: 'custom-vendor-marker',
        html: `
          <div style="background-color: ${markerColor}; width: 34px; height: 34px; border-radius: 50%; border: 3px solid white; box-shadow: 0 4px 10px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; font-size: 14px;">
            ${statusIcon}
          </div>
        `,
        iconSize: [34, 34],
        iconAnchor: [17, 34],
        popupAnchor: [0, -32]
      });

      const marker = L.marker([vendor.lat, vendor.lng], { icon: customIcon }).addTo(mapInstance);
      const ratingText = Number(vendor.rating) > 0 ? `★ ${Number(vendor.rating).toFixed(1)} (${vendor.reviewsCount} ulasan)` : 'Belum ada rating';
      const productList = (vendor.products || []).map(product =>
        `<li style="font-size:11px;color:#374151;margin-top:3px">${escapePopupText(product.name)} <span style="color:#6B7280">· Rp ${Number(product.price).toLocaleString('id-ID')}</span></li>`
      ).join('');
      const profileImage = String(vendor.shop_image || '/assets/images/hero-nemusnack.jpg');
      const safeImage = profileImage.startsWith('/') || profileImage.startsWith('https://') ? profileImage : '/assets/images/hero-nemusnack.jpg';
      const popupHtml = `<div style="min-width:230px;max-width:280px;font-family:'Plus Jakarta Sans',sans-serif">
        <img src="${escapePopupText(safeImage)}" alt="" style="width:100%;height:110px;object-fit:cover;border-radius:12px;margin-bottom:8px">
        <div style="display:flex;justify-content:space-between;gap:8px;margin-bottom:4px">
          <span style="font-size:10px;font-weight:800;color:${markerColor};background:#F3F4F6;padding:3px 8px;border-radius:20px">${escapePopupText(vendor.seller_status)}</span>
          <span style="font-size:10px;font-weight:800;color:#B45309">${ratingText}</span>
        </div>
        <h4 style="font-size:14px;font-weight:800;margin:0 0 2px;color:#111827">${escapePopupText(vendor.shop_name)}</h4>
        <p style="font-size:11px;color:#4B5563;margin:0 0 6px">${escapePopupText(vendor.shop_description)}</p>
        <p style="font-size:11px;color:#6B7280;margin:0 0 5px">${escapePopupText(vendor.seller_location)}</p>
        <p style="font-size:11px;color:#1D4ED8;margin:0 0 5px"><strong>Rute/jam:</strong> ${escapePopupText(vendor.seller_route)}</p>
        ${(vendor.seller_route_points || []).length > 1 ? '<p style="font-size:10px;color:#1D4ED8;margin:0 0 5px">Garis biru menunjukkan urutan titik rute.</p>' : ''}
        <ul style="list-style:none;padding:0;margin:6px 0;border-top:1px solid #E5E7EB;padding-top:5px">${productList || '<li style="font-size:11px;color:#6B7280">Belum ada produk di katalog.</li>'}</ul>
        <a href="/lapak/${Number(vendor.id)}" style="display:inline-block;margin-top:4px;font-size:11px;font-weight:800;color:white;background:#FF532A;padding:6px 12px;border-radius:20px;text-decoration:none">Lihat profil & katalog</a>
      </div>`;
      marker.bindPopup(popupHtml);
      marker.vendorData = vendor;
      mapLayers.push(marker);

      const routePoints = vendor.seller_route_points || [];
      if (routePoints.length > 1) {
        const routeLine = L.polyline(routePoints, {
          color: '#2563EB', weight: 7, opacity: 0.9, dashArray: '14 8', lineCap: 'round'
        }).addTo(mapInstance);
        routeLine.bindTooltip(`Rute ${escapePopupText(vendor.shop_name)} · titik berurutan 1–${routePoints.length}`);
        mapLayers.push(routeLine);
        routePoints.forEach((point, index) => {
          const routePoint = L.circleMarker(point, {
            radius: 6, color: '#fff', weight: 2, fillColor: '#2563EB', fillOpacity: 1
          }).bindTooltip(`Titik rute ${index + 1}`).addTo(mapInstance);
          mapLayers.push(routePoint);
        });
      }
    });
  }

  // Filter Marker di Peta
  function filterMapMarkers(status) {
    currentMapFilter = status;
    document.querySelectorAll('#btn-filter-all, #btn-filter-mangkal, #btn-filter-jalan').forEach(btn => {
      btn.className = 'px-4 py-1.5 rounded-full text-xs font-bold text-gray-600 hover:text-brand-orange transition-all';
    });

    if (status === 'all') {
      document.getElementById('btn-filter-all').className = 'px-4 py-1.5 rounded-full text-xs font-black bg-brand-orange text-white shadow-sm transition-all';
      renderVendorMarkers(vendorsData);
    } else {
      const filtered = vendorsData.filter(v => v.seller_status === status || (status === 'Sedang Berjalan' && v.seller_status === 'Berjalan'));
      if (status === 'Mangkal') {
        document.getElementById('btn-filter-mangkal').className = 'px-4 py-1.5 rounded-full text-xs font-black bg-emerald-500 text-white shadow-sm transition-all';
      } else {
        document.getElementById('btn-filter-jalan').className = 'px-4 py-1.5 rounded-full text-xs font-black bg-amber-500 text-white shadow-sm transition-all';
      }
      renderVendorMarkers(filtered);
    }
  }

  async function refreshVendorMarkers() {
    try {
      const response = await fetch('/api/lapak/peta', { headers: { Accept: 'application/json' } });
      if (!response.ok) return;
      const payload = await response.json();
      if (!payload.success || !Array.isArray(payload.data)) return;
      vendorsData = payload.data;
      const visibleVendors = currentMapFilter === 'all'
        ? vendorsData
        : vendorsData.filter(vendor => vendor.seller_status === currentMapFilter || (currentMapFilter === 'Sedang Berjalan' && vendor.seller_status === 'Berjalan'));
      renderVendorMarkers(visibleVendors);
    } catch (error) {
      console.warn('Penyegaran peta lapak gagal:', error);
    }
  }

  // ==========================================
  // AI Assistant Chatbot Functions (POST /api/chat)
  // ==========================================
  const chatMessagesContainer = document.getElementById('ai-chat-messages');
  const chatInput = document.getElementById('ai-user-query');
  const sendButton = document.getElementById('ai-send-button');
  const btnText = document.getElementById('ai-btn-text');
  const btnIcon = document.getElementById('ai-btn-icon');
  const charCounter = document.getElementById('ai-char-counter');
  const errorBox = document.getElementById('ai-error-box');
  const errorMessage = document.getElementById('ai-error-message');

  // Update counter karakter
  if (chatInput && charCounter) {
    chatInput.addEventListener('input', () => {
      const len = chatInput.value.length;
      charCounter.textContent = `${len}/500`;
      if (len >= 480) {
        charCounter.classList.add('text-red-500', 'font-bold');
      } else {
        charCounter.classList.remove('text-red-500', 'font-bold');
      }
    });
  }

  // Format teks respons AI (markdown sederhana: bold, list, newline)
  function formatAiMarkdown(text) {
    if (!text) return '';
    let escaped = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // Bold **teks**
    escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

    // List item (* atau - di awal baris)
    escaped = escaped.replace(/^[*-]\s+(.+)$/gm, '<li class="ml-4 list-disc">$1</li>');

    // Baris baru
    escaped = escaped.replace(/\n/g, '<br/>');

    return escaped;
  }

  function getCurrentTimeString() {
    const now = new Date();
    return now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
  }

  function appendMessageBubble(sender, text, isError = false) {
    if (!chatMessagesContainer) return;
    const timeStr = getCurrentTimeString();
    const bubbleWrapper = document.createElement('div');

    if (sender === 'user') {
      bubbleWrapper.className = 'flex items-start space-x-3 max-w-[85%] self-end flex-row-reverse space-x-reverse';
      bubbleWrapper.innerHTML = `
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-brand-orange to-amber-500 text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm">
          K
        </div>
        <div>
          <div class="bg-brand-orange text-white p-4 rounded-2xl rounded-tr-none shadow-sm text-sm leading-relaxed">
            ${formatAiMarkdown(text)}
          </div>
          <span class="block text-[10px] text-gray-400 mt-1 text-right">${timeStr} • Kamu</span>
        </div>
      `;
    } else {
      bubbleWrapper.className = 'flex items-start space-x-3 max-w-[85%] self-start';
      const bgClass = isError ? 'bg-red-50 border-red-200 text-red-800' : 'bg-white border-gray-100 text-gray-800';
      bubbleWrapper.innerHTML = `
        <div class="w-8 h-8 rounded-full ${isError ? 'bg-red-500' : 'bg-brand-orange'} text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm">
          ${isError ? '!' : 'N'}
        </div>
        <div>
          <div class="${bgClass} p-4 rounded-2xl rounded-tl-none border shadow-sm text-sm leading-relaxed">
            <p class="font-bold text-xs mb-1 ${isError ? 'text-red-600' : 'text-brand-orange'}">
              Asisten NemuSnack${isError ? ' · Peringatan' : ''}
            </p>
            <div>${formatAiMarkdown(text)}</div>
          </div>
          <span class="block text-[10px] text-gray-400 mt-1">${timeStr} • Asisten</span>
        </div>
      `;
    }

    chatMessagesContainer.appendChild(bubbleWrapper);
    chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
  }

  function showLoadingIndicator() {
    if (!chatMessagesContainer) return;
    const loadingElem = document.createElement('div');
    loadingElem.id = 'ai-typing-indicator';
    loadingElem.className = 'flex items-start space-x-3 max-w-[85%] self-start';
    loadingElem.innerHTML = `
      <div class="w-8 h-8 rounded-full bg-brand-orange text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm animate-spin">
        N
      </div>
      <div class="bg-white p-4 rounded-2xl rounded-tl-none border border-gray-100 shadow-sm text-sm text-gray-500 flex items-center space-x-2">
        <span class="font-bold text-brand-orange text-xs">AI sedang meracik jawaban</span>
        <span class="flex space-x-1">
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-bounce"></span>
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-bounce [animation-delay:0.2s]"></span>
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-bounce [animation-delay:0.4s]"></span>
        </span>
      </div>
    `;
    chatMessagesContainer.appendChild(loadingElem);
    chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
  }

  function removeLoadingIndicator() {
    const loadingElem = document.getElementById('ai-typing-indicator');
    if (loadingElem) {
      loadingElem.remove();
    }
  }

  function showAiError(msg) {
    if (errorBox && errorMessage) {
      errorMessage.textContent = msg;
      errorBox.classList.remove('hidden');
    }
  }

  function dismissAiError() {
    if (errorBox) {
      errorBox.classList.add('hidden');
    }
  }

  async function askAiPrompt(promptText) {
    if (!promptText || !chatInput) return;
    chatInput.value = promptText;
    if (charCounter) charCounter.textContent = `${promptText.length}/500`;
    await submitChatMessage(promptText);
  }

  async function handleAiChatSubmit(e) {
    e.preventDefault();
    if (!chatInput) return;
    const query = chatInput.value.trim();
    if (!query) return;
    await submitChatMessage(query);
  }

  async function submitChatMessage(messageText) {
    dismissAiError();

    // 1. Tampilkan bubble pesan user
    appendMessageBubble('user', messageText);
    if (chatInput) chatInput.value = '';
    if (charCounter) charCounter.textContent = '0/500';

    // 2. Set loading state
    if (sendButton) sendButton.disabled = true;
    if (chatInput) chatInput.disabled = true;
    if (btnText) btnText.textContent = 'Memproses...';
    if (btnIcon) btnIcon.textContent = '⏳';

    showLoadingIndicator();

    try {
      // 3. Kirim via Fetch API ke backend Express.js (POST /api/chat)
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ message: messageText })
      });

      const result = await response.json();
      removeLoadingIndicator();

      if (!response.ok || !result.success) {
        const errMsg = result.message || 'Asisten sedang mengalami kendala. Silakan coba kembali nanti.';
        appendMessageBubble('ai', `! ${errMsg}`, true);
        showAiError(errMsg);
        return;
      }

      // 4. Tampilkan respons asisten NemuSnack
      const reply = result.data && result.data.reply ? result.data.reply : 'Maaf, tidak ada balasan dari sistem.';
      appendMessageBubble('ai', reply);

    } catch (err) {
      console.error('Chat error:', err);
      removeLoadingIndicator();
      const failMsg = 'Gagal menghubungi server backend. Pastikan server aktif dan koneksi internet stabil.';
      appendMessageBubble('ai', `! ${failMsg}`, true);
      showAiError(failMsg);
    } finally {
      // 5. Kembalikan state normal
      if (sendButton) sendButton.disabled = false;
      if (chatInput) {
        chatInput.disabled = false;
        chatInput.focus();
      }
      if (btnText) btnText.textContent = 'Kirim';
      if (btnIcon) btnIcon.textContent = '➤';
    }
  }

  function clearChatHistory() {
    if (!chatMessagesContainer) return;
    chatMessagesContainer.innerHTML = `
      <div class="flex items-start space-x-3 max-w-[85%] self-start">
        <div class="w-8 h-8 rounded-full bg-brand-orange text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm">
          N
        </div>
        <div class="bg-white p-4 rounded-2xl rounded-tl-none border border-gray-100 shadow-sm text-sm text-gray-800 leading-relaxed">
          <p class="font-bold text-brand-orange text-xs mb-1">Asisten NemuSnack</p>
          <p>Percakapan telah direset. Ada jajanan kaki lima lainnya yang ingin kamu tanyakan?</p>
        </div>
      </div>
    `;
    dismissAiError();
  }

  // Load Map saat DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    initTrackingMap();
  });
</script>
