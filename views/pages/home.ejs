              <svg class="w-4 h-4 fill-current ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <span>Buka Peta Lapak</span>
          </a>
        </div>

        <!-- Social Proof (Matching Reference: Avatars + 10K+ Happy Customers) -->
        <div class="pt-4 flex items-center justify-center lg:justify-start space-x-4">
          <div class="flex -space-x-2.5 overflow-hidden">
            <img class="inline-block h-10 w-10 rounded-full ring-2 ring-white object-cover" src="/assets/images/testimonial-person.jpg" alt="Pelanggan 1">
            <img class="inline-block h-10 w-10 rounded-full ring-2 ring-white object-cover" src="/assets/images/hero-person.jpg" alt="Pelanggan 2">
            <div class="h-10 w-10 rounded-full ring-2 ring-white bg-brand-orange text-white font-black text-xs flex items-center justify-center">
              +10k
            </div>
          </div>
          <div class="text-left">
            <p class="text-sm font-extrabold text-gray-900">10K+ Pelanggan Jajanan</p>
