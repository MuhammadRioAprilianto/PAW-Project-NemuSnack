<!-- Halaman Utama (Home) Kebab Corner -->

<!-- 1. HERO SECTION -->
<section class="relative overflow-hidden bg-gradient-to-b from-brand-warm/60 via-white to-transparent py-12 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Hero Text & CTA -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-brand-orange/10 border border-brand-orange/20 text-brand-orange text-xs sm:text-sm font-bold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"></span>
          <span>100% Halal & Dibuat Dari Bahan Pilihan</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-brown tracking-tight leading-[1.15]">
          Kebab Lezat, Dibuat <span class="text-brand-orange underline decoration-brand-accent/40 decoration-wavy decoration-2">Fresh</span> Setiap Hari
        </h1>

        <p class="text-base sm:text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Selamat datang di <span class="font-bold text-brand-brown">Kebab Corner</span>! Nikmati kelezatan perpaduan kulit tortilla yang renyah dan lembut, daging sapi panggang berbumbu rempah autentik, sayuran segar, serta guyuran saus rahasia yang melimpah di setiap gigitan.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a href="/menu" 
             class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl font-bold text-base text-white bg-brand-orange hover:bg-brand-orange-hover shadow-lg shadow-brand-orange/30 hover:shadow-xl hover:shadow-brand-orange/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
            <span>Lihat Menu</span>
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>

          <a href="/#contact" 
             class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl font-bold text-base text-brand-brown bg-white hover:bg-brand-warm border-2 border-brand-brown/15 shadow-sm hover:shadow transition-all duration-200">
            <span>Pesan Sekarang</span>
          </a>
        </div>

        <!-- Quick Trust Badges -->
        <div class="pt-6 grid grid-cols-3 gap-4 border-t border-gray-100 max-w-lg mx-auto lg:mx-0">
          <div class="text-center lg:text-left">
            <p class="text-2xl font-black text-brand-orange">100%</p>
            <p class="text-xs text-gray-500 font-medium">Bahan Berkualitas</p>
          </div>
          <div class="text-center lg:text-left">
            <p class="text-2xl font-black text-brand-brown">Fresh</p>
            <p class="text-xs text-gray-500 font-medium">Made to Order</p>
          </div>
          <div class="text-center lg:text-left">
            <p class="text-2xl font-black text-brand-accent">6+</p>
            <p class="text-xs text-gray-500 font-medium">Varian Menu</p>
          </div>
        </div>
      </div>

      <!-- Hero Visual Image -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="relative w-full max-w-md lg:max-w-none">
          <!-- Ambient Glow Background -->
          <div class="absolute -inset-4 bg-gradient-to-r from-brand-orange/20 to-brand-accent/30 rounded-3xl blur-2xl transform -rotate-3"></div>
          
          <!-- Image Container -->
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-white group">
            <img src="/assets/images/hero-kebab.jpg" 
                 alt="Kebab Corner Spesial Lezat" 
                 class="w-full h-80 sm:h-96 lg:h-[450px] object-cover object-center transform group-hover:scale-105 transition-transform duration-500"
                 onerror="this.onerror=null; this.src='/assets/images/kebab-placeholder.svg';">

            <!-- Floating Pill Badge 1 -->
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-md px-3.5 py-2 rounded-xl shadow-lg border border-white/50 flex items-center space-x-2">
              <span class="text-lg">🔥</span>
              <div>
                <p class="text-[11px] font-bold text-gray-800">Daging Panggang</p>
                <p class="text-[10px] text-gray-500">Bumbu Khas Rempah</p>
              </div>
            </div>

            <!-- Floating Pill Badge 2 -->
            <div class="absolute bottom-4 right-4 bg-brand-brown/95 backdrop-blur-md px-4 py-2.5 rounded-xl shadow-lg border border-white/10 text-white flex items-center space-x-3">
              <div class="w-8 h-8 rounded-lg bg-brand-orange flex items-center justify-center text-sm font-bold">
                ✓
              </div>
              <div>
                <p class="text-xs font-bold">Fresh Setiap Hari</p>
                <p class="text-[10px] text-gray-300">Siap Saji Hangat</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- 2. FEATURED PRODUCTS SECTION -->
<section class="py-16 lg:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-orange/10 text-brand-orange text-xs font-bold uppercase tracking-wider mb-3">
        Menu Favorit
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-brown tracking-tight">
        Produk Unggulan Kebab Corner
      </h2>
      <p class="mt-3 text-base sm:text-lg text-gray-600">
        Pilihan terpopuler yang paling banyak digemari pelanggan kami dengan sensasi rasa tak terlupakan.
      </p>
    </div>

    <!-- Product Cards Grid (3 Featured Products) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
        <% featuredProducts.forEach((product) => { %>
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col overflow-hidden group">
            
            <!-- Card Image -->
            <div class="relative h-60 w-full overflow-hidden bg-gray-100">
              <img src="<%= product.image %>" 
                   alt="<%= product.name %>" 
                   class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                   onerror="this.onerror=null; this.src='/assets/images/kebab-placeholder.svg';">
              
              <!-- Category Badge -->
              <span class="absolute top-3 left-3 bg-brand-brown/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-1 rounded-lg shadow-sm">
                <%= product.category %>
              </span>
            </div>

            <!-- Card Body -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-xl font-bold text-gray-900 group-hover:text-brand-orange transition-colors">
                  <%= product.name %>
                </h3>
                <p class="mt-2 text-sm text-gray-600 line-clamp-2 leading-relaxed">
                  <%= product.description %>
                </p>
              </div>

              <!-- Price & Action -->
              <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between">
                <div>
                  <span class="text-xs text-gray-400 block font-medium">Harga</span>
                  <span class="text-xl font-extrabold text-brand-orange">
                    <%= formatCurrency(product.price) %>
                  </span>
                </div>

                <a href="/menu" 
                   class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-bold text-brand-brown bg-brand-warm hover:bg-brand-orange hover:text-white transition-all duration-200">
                  <span>Lihat Menu</span>
                  <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>

          </div>
        <% }); %>
      <% } else { %>
        <div class="col-span-3 text-center py-12 text-gray-500">
          Belum ada produk unggulan yang tersedia.
        </div>
      <% } %>
    </div>

    <!-- More Menu Button -->
    <div class="text-center mt-12">
      <a href="/menu" 
         class="inline-flex items-center px-7 py-3.5 rounded-xl font-bold text-sm text-white bg-brand-brown hover:bg-brand-brown-light shadow-md hover:shadow-lg transition-all duration-200">
        <span>Jelajahi Seluruh Menu Kebab</span>
        <svg class="w-4 h-4 ml-2 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<!-- 3. WHY CHOOSE US SECTION -->
<section class="py-16 lg:py-24 bg-brand-warm/40 border-y border-brand-warm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-orange/10 text-brand-orange text-xs font-bold uppercase tracking-wider mb-3">
