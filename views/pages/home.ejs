<!-- Halaman Utama (Home) NemuSnack - Agency Design Style -->

<!-- 1. HERO SECTION (Inspired by Zesty Agency Design) -->
<section class="relative overflow-hidden pt-6 pb-16 lg:pt-10 lg:pb-24">
