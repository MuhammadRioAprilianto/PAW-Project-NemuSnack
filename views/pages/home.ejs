<!-- SCRIPT AI INTERAKTIF -->
<script>
  async function askAiPrompt(query) {
    document.getElementById('ai-user-query').value = query;
    await executeAiQuery(query);
  }

  async function handleAiSubmit(e) {
    e.preventDefault();
    const query = document.getElementById('ai-user-query').value.trim();
    if (!query) return;
    await executeAiQuery(query);
  }

  async function executeAiQuery(query) {
    const resultBox = document.getElementById('ai-result-content');
    resultBox.innerHTML = `<p class="text-gray-500 animate-pulse">Sedang mencari rekomendasi jajanan terbaik untukmu...</p>`;

    try {
      const response = await fetch(`/api/rekomendasi?q=${encodeURIComponent(query)}`);
      const data = await response.json();

      if (data.recommendations && data.recommendations.length > 0) {
        let html = `<p class="font-semibold text-gray-800">${data.message}:</p><div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">`;
        data.recommendations.forEach(item => {
          html += `
            <div class="p-3 bg-white rounded-xl border border-orange-200 shadow-sm">
              <div class="flex items-center justify-between">
                <span class="font-bold text-gray-900 text-sm">${item.name}</span>
                <span class="text-xs font-extrabold text-brand-orange">Rp ${item.price.toLocaleString('id-ID')}</span>
              </div>
              <p class="text-xs text-gray-500 mt-1">📍 ${item.seller} • ${item.status}</p>
              <p class="text-[11px] text-gray-600 mt-1 line-clamp-1">${item.description}</p>
              <a href="/menu?id=${item.id}" class="inline-block mt-2 text-xs font-bold text-brand-orange hover:underline">
                Lihat di Katalog &rarr;
              </a>
            </div>
          `;
        });
        html += `</div>`;
        resultBox.innerHTML = html;
      } else {
        resultBox.innerHTML = `<p class="text-gray-600">Tidak ada jajanan yang cocok dengan kata kunci tersebut. Coba cari "manis" atau "pedas".</p>`;
      }
    } catch (err) {
      console.error(err);
      resultBox.innerHTML = `<p class="text-red-500">Gagal menghubungi layanan rekomendasi.</p>`;
    }
  }
</script>
