<!-- Halaman Utama (Home) NemuSnack - Agency Design Style -->

<!-- 1. HERO SECTION (Inspired by Zesty Agency Design) -->
<section class="relative overflow-hidden pt-6 pb-16 lg:pt-10 lg:pb-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Left Column: Headline & Action -->
      <div class="lg:col-span-7 space-y-7 text-center lg:text-left">

        <!-- Top Pill Tag -->
        <div class="inline-flex items-center space-x-2 px-4 py-2 rounded-full bg-orange-100/70 border border-orange-200/60 text-brand-orange text-xs sm:text-sm font-extrabold tracking-wide">
          <span>⚡</span>
          <span>Cepat • Fresh • Dilacak Real-Time</span>
        </div>

        <!-- Big Agency Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-gray-900 tracking-tight leading-[1.1]">
          Jajanan Lezat, <br class="hidden sm:inline"/>
          <span class="text-brand-orange">Dilacak Cepat</span> <br class="hidden sm:inline"/>
          Di Sekitarmu
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-gray-600 leading-relaxed max-w-xl mx-auto lg:mx-0">
          Lapar dan rindu jajanan kaki lima favorit? NemuSnack memetakan lokasi gerobak mangkal maupun rute keliling secara live, hangat, dan siap dinikmati kapan saja.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-1">
          <a href="/menu"
             class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full font-black text-base text-white bg-brand-orange hover:bg-brand-orange-hover shadow-xl shadow-brand-orange/30 hover:shadow-2xl hover:shadow-brand-orange/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
            <span>Cari Jajanan Sekarang</span>
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <a href="#map-tracking"
             class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-4 rounded-full font-bold text-base text-gray-800 bg-white hover:bg-orange-50 border border-gray-200 shadow-sm hover:shadow transition-all duration-200 group">
            <span class="w-8 h-8 rounded-full bg-orange-100 text-brand-orange flex items-center justify-center mr-2.5 group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4 fill-current ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <span>Buka Peta Lapak</span>
          </a>
        </div>

        <!-- Social Proof (Matching Reference: Avatars + 10K+ Happy Customers) -->
        <div class="pt-4 flex items-center justify-center lg:justify-start space-x-4">
          <div class="flex -space-x-2.5 overflow-hidden">
            <img class="inline-block h-10 w-10 rounded-full ring-2 ring-white object-cover" src="/assets/images/testimonial-person.jpg" alt="Pelanggan 1">
            <img class="inline-block h-10 w-10 rounded-full ring-2 ring-white object-cover" src="/assets/images/hero-person.jpg" alt="Pelanggan 2">
            <div class="h-10 w-10 rounded-full ring-2 ring-white bg-brand-orange text-white font-black text-xs flex items-center justify-center">
              +10k
            </div>
          </div>
          <div class="text-left">
            <p class="text-sm font-extrabold text-gray-900">10K+ Pelanggan Jajanan</p>
            <div class="flex items-center text-amber-500 text-xs">
              <span>★★★★★</span>
              <span class="font-extrabold text-gray-700 ml-1.5">(4.9)</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Container (Organic Shape + High-res Photo + Floating Cards) -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="relative w-full max-w-md lg:max-w-none">

          <!-- Soft Organic Backdrop -->
          <div class="absolute inset-0 bg-gradient-to-tr from-orange-200/60 to-amber-100/50 rounded-full filter blur-2xl transform scale-110"></div>

          <!-- Main Hero Circular Image -->
          <div class="relative z-10 w-full h-[400px] sm:h-[480px] rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-white bg-white group">
            <img src="/assets/images/hero-person.jpg"
                 alt="Menikmati Jajanan NemuSnack"
                 class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700"
                 onerror="this.onerror=null; this.src='/assets/images/hero-nemusnack.jpg';">

            <!-- Floating Pill 1: Waktu Operasional (Matching Reference) -->
            <div class="absolute bottom-6 left-6 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl shadow-xl border border-white/60 flex items-center space-x-3">
              <div class="w-9 h-9 rounded-xl bg-orange-100 text-brand-orange flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-[11px] text-gray-500 font-semibold">Jam Buka Ramai</p>
                <p class="text-xs font-black text-gray-900">15.30 - 22.00 WIB</p>
              </div>
            </div>

            <!-- Floating Card 2: 100% Street Food (Matching Reference) -->
            <div class="absolute top-6 right-6 bg-white/95 backdrop-blur-md p-3 rounded-2xl shadow-xl border border-white/60 flex items-center space-x-3">
              <img src="/assets/images/snack-piscok.jpg" class="w-11 h-11 rounded-xl object-cover" alt="Snack">
              <div class="pr-1">
                <p class="text-[11px] font-black text-brand-orange">Lapak Aktif</p>
                <p class="text-xs font-extrabold text-gray-900">Siap Dipesan</p>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- 2. WHY CHOOSE US (Matching Reference Section Layout) -->
<section id="why-us" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="text-xs font-black text-brand-orange tracking-widest uppercase mb-2">• KENAPA NEMUSNACK •</p>
      <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">
        Teman Terbaik Berburu Jajanan Kaki Lima
      </h2>
    </div>

    <!-- 3 Clean Feature Cards (Matching Reference Visuals) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <!-- Feature 1: Lightning Fast Tracking -->
      <div class="p-8 rounded-3xl bg-[#FAF8F5] border border-gray-100 hover:shadow-card-hover transition-all duration-300 text-center flex flex-col items-center">
        <div class="w-20 h-20 rounded-2xl bg-orange-100 flex items-center justify-center text-xs font-black tracking-widest mb-6 shadow-sm">
          PETA
        </div>
        <h3 class="text-xl font-black text-gray-900 mb-2">Pelacakan Cepat (Live)</h3>
        <p class="text-sm text-gray-600 leading-relaxed max-w-xs">
          Pantau posisi gerobak mangkal dan rute keliling secara real-time langsung melalui peta interaktif.
        </p>
      </div>

      <!-- Feature 2: Wide Variety -->
      <div class="p-8 rounded-3xl bg-[#FAF8F5] border border-gray-100 hover:shadow-card-hover transition-all duration-300 text-center flex flex-col items-center">
        <div class="w-20 h-20 rounded-2xl bg-amber-100 flex items-center justify-center text-xs font-black tracking-widest mb-6 shadow-sm">
          MENU
        </div>
        <h3 class="text-xl font-black text-gray-900 mb-2">Pilihan Beragam</h3>
        <p class="text-sm text-gray-600 leading-relaxed max-w-xs">
          Dari pisang cokelat lumer, tahu gejrot pedas, telur gulung, hingga martabak mini dengan harga ramah kantong.
        </p>
      </div>

      <!-- Feature 3: Top Quality -->
      <div class="p-8 rounded-3xl bg-[#FAF8F5] border border-gray-100 hover:shadow-card-hover transition-all duration-300 text-center flex flex-col items-center">
        <div class="w-20 h-20 rounded-2xl bg-emerald-100 flex items-center justify-center text-xs font-black tracking-widest mb-6 shadow-sm">
          RATING
        </div>
        <h3 class="text-xl font-black text-gray-900 mb-2">Kualitas &amp; Fresh</h3>
        <p class="text-sm text-gray-600 leading-relaxed max-w-xs">
          Dimasak dan diracik hangat seketika saat kamu tiba di lapak, menjamin rasa renyah dan kenikmatan maksimal.
        </p>
      </div>

    </div>

  </div>
</section>

<!-- 3. LIVE MAP TRACKING SECTION (NEW REQUESTED FEATURE!) -->
<section id="map-tracking" class="py-20 bg-gradient-to-b from-white via-orange-50/30 to-white border-y border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <p class="text-xs font-black text-brand-orange tracking-widest uppercase mb-1">• LIVE MAP TRACKING •</p>
        <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">
          Peta Pelacakan Gerobak &amp; Lapak PKL Aktif
        </h2>
        <p class="mt-2 text-sm text-gray-600">
          Titik posisi gerobak yang sedang mangkal atau berkeliling di area kampus dan sekitarnya.
        </p>
      </div>

      <!-- Filter Map Markers Buttons -->
      <div class="flex items-center space-x-2 bg-white p-1.5 rounded-full border border-gray-200 shadow-sm">
        <button onclick="filterMapMarkers('all')" id="btn-filter-all" class="px-4 py-1.5 rounded-full text-xs font-black bg-brand-orange text-white shadow-sm transition-all">
          Semua Lapak
        </button>
        <button onclick="filterMapMarkers('Mangkal')" id="btn-filter-mangkal" class="px-4 py-1.5 rounded-full text-xs font-bold text-gray-600 hover:text-brand-orange transition-all flex items-center">
          <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5"></span> Mangkal
        </button>
        <button onclick="filterMapMarkers('Sedang Berjalan')" id="btn-filter-jalan" class="px-4 py-1.5 rounded-full text-xs font-bold text-gray-600 hover:text-brand-orange transition-all flex items-center">
          <span class="w-2 h-2 rounded-full bg-amber-500 mr-1.5"></span> Berjalan
        </button>
      </div>
    </div>

    <!-- Interactive Leaflet Map Container -->
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-gray-100">
      <div id="tracking-map" class="w-full h-[480px] z-10"></div>

      <!-- Overlay Map Legend -->
      <div class="absolute bottom-4 left-4 z-20 bg-white/95 backdrop-blur-md px-4 py-3 rounded-2xl shadow-lg border border-gray-100 text-xs space-y-1 hidden sm:block">
        <p class="font-extrabold text-gray-900 mb-1">Keterangan Pin Peta:</p>
        <div class="flex items-center space-x-2">
          <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
          <span class="text-gray-700 font-semibold">Lapak Mangkal Menetap</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
          <span class="text-gray-700 font-semibold">Gerobak Sedang Berjalan</span>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- 4. EXPLORE OUR MENU SECTION (Matching Reference: Tasty Food You'll Love) -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <p class="text-xs font-black text-brand-orange tracking-widest uppercase mb-1">• EXPLORE OUR MENU •</p>
        <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">
          Jajanan Favorit Terlaris
        </h2>
      </div>

      <!-- Action Nav Buttons (Matching Reference Arrow Buttons) -->
      <div class="flex items-center space-x-3">
        <a href="/menu" class="text-sm font-bold text-brand-orange hover:underline flex items-center">
          <span>Lihat Semua Menu</span>
          <span class="ml-1">→</span>
        </a>
      </div>
    </div>

    <!-- Product Cards Grid (Matching Reference Image Card Design) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
        <% featuredProducts.forEach((product) => { %>
          <div class="bg-white rounded-[2rem] border border-gray-100 p-4 shadow-card hover:shadow-card-hover hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group">

            <!-- Card Image Container -->
            <div class="relative h-64 w-full rounded-[1.5rem] overflow-hidden bg-gray-100 mb-5">
              <img src="<%= product.image %>"
                   alt="<%= product.name %>"
                   class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                   onerror="this.onerror=null; this.src='/assets/images/snack-placeholder.svg';">

              <!-- Status Pill (Top Left) -->
              <% if (product.status === 'Mangkal') { %>
                <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-emerald-700 text-xs font-extrabold px-3 py-1.5 rounded-full shadow-sm flex items-center">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span> Mangkal
                </span>
              <% } else if (product.status === 'Sedang Berjalan' || product.status === 'Berjalan') { %>
                <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-amber-800 text-xs font-extrabold px-3 py-1.5 rounded-full shadow-sm flex items-center">
                  Berjalan
                </span>
              <% } else if (product.status === 'Libur') { %>
                <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-slate-700 text-xs font-extrabold px-3 py-1.5 rounded-full shadow-sm">Libur</span>
              <% } else { %>
                <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-gray-700 text-xs font-extrabold px-3 py-1.5 rounded-full shadow-sm">Tutup</span>
              <% } %>

              <!-- Heart Button (Top Right, Matching Reference) -->
              <button class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 backdrop-blur-md text-gray-500 hover:text-red-500 hover:bg-white flex items-center justify-center shadow-sm transition-colors">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              </button>
            </div>

            <!-- Card Body -->
            <div class="px-2 pb-2 flex-1 flex flex-col justify-between">
              <div>
                <p class="text-xs font-bold text-gray-400 mb-1"><%= product.seller %></p>
                <h3 class="text-xl font-extrabold text-gray-900 group-hover:text-brand-orange transition-colors">
                  <%= product.name %>
                </h3>

                <!-- Rating (Matching Reference) -->
                <div class="flex items-center text-xs text-amber-500 font-extrabold mt-1.5 mb-3">
                  <span><%= product.rating > 0 ? `★ ${Number(product.rating).toFixed(1)}` : 'Belum ada rating' %></span>
                  <span class="text-gray-400 font-semibold ml-1.5">(<%= product.reviewsCount %>)</span>
                </div>
              </div>

              <!-- Price & Order Action (Matching Reference) -->
              <div class="pt-3 border-t border-gray-100 flex items-center justify-between mt-auto">
                <div>
                  <span class="text-2xl font-black text-gray-900">
                    <%= formatCurrency(product.price) %>
                  </span>
                </div>

                <div class="flex items-center space-x-2">
                  <a href="<%= product.seller_id ? `/lapak/${product.seller_id}` : `/produk/${product.id}` %>"
                     class="px-5 py-2.5 rounded-full font-bold text-xs text-white bg-brand-orange hover:bg-brand-orange-hover shadow-md shadow-brand-orange/20 transition-all">
                    Lihat Lapak
                  </a>
                </div>
              </div>

            </div>

          </div>
        <% }); %>
      <% } %>
    </div>

  </div>
</section>

<!-- 5. INTERACTIVE SMART AI ASSISTANT CHATBOT -->
<section id="ai-assistant" class="py-16 bg-[#FAF8F5]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-8">
      <span class="text-xs font-black text-brand-orange tracking-widest uppercase mb-1 block">• SMART AI ASSISTANT •</span>
      <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
        Tanya Asisten NemuSnack
      </h2>
      <p class="text-xs sm:text-sm text-gray-500 mt-2">
        Konsultasikan selera jajananmu, cari info harga, posisi lapak mangkal, atau tanyakan rekomendasi kuliner PKL terbaik!
      </p>
    </div>

    <!-- Chat Card Component -->
    <div class="bg-white rounded-[2.5rem] border border-gray-100 shadow-xl overflow-hidden">

      <!-- Chatbot Header Banner -->
      <div class="bg-gradient-to-r from-brand-orange via-orange-500 to-amber-500 p-6 sm:p-7 text-white">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-2xl shadow-inner border border-white/30 shrink-0">
              N
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <h3 class="text-lg sm:text-xl font-black tracking-tight">Asisten NemuSnack</h3>
              </div>
              <p class="text-xs text-white/90 mt-0.5">
                Temukan informasi jajanan dan lapak di sekitarmu.
              </p>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <button onclick="clearChatHistory()" type="button" class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold border border-white/20 transition-all flex items-center space-x-1.5" title="Bersihkan percakapan">
              <span>Reset Chat</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Suggestion Pills -->
      <div class="p-4 sm:px-6 bg-orange-50/40 border-b border-gray-100">
        <p class="text-[11px] font-extrabold text-gray-500 uppercase tracking-wider mb-2">Pertanyaan Rekomendasi:</p>
        <div class="flex flex-wrap gap-2">
          <button type="button" onclick="askAiPrompt('Apa saja produk yang tersedia di aplikasi ini?')" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-brand-orange hover:text-white text-gray-700 border border-gray-200 shadow-sm transition-all">
            Apa saja produk yang tersedia?
          </button>
          <button type="button" onclick="askAiPrompt('Rekomendasikan jajanan manis lumer sore ini')" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-brand-orange hover:text-white text-gray-700 border border-gray-200 shadow-sm transition-all">
            Jajanan manis lumer
          </button>
          <button type="button" onclick="askAiPrompt('Jajanan apa yang paling murah di bawah 12 ribu?')" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-brand-orange hover:text-white text-gray-700 border border-gray-200 shadow-sm transition-all">
            Jajanan murah &lt; Rp12.000
          </button>
          <button type="button" onclick="askAiPrompt('Rekomendasikan camilan pedas dan gurih')" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-white hover:bg-brand-orange hover:text-white text-gray-700 border border-gray-200 shadow-sm transition-all">
            Camilan pedas gurih
          </button>
        </div>
      </div>

      <!-- Chat Messages Scrollable Box -->
      <div id="ai-chat-messages" class="p-6 sm:p-8 space-y-4 max-h-[460px] min-h-[300px] overflow-y-auto bg-[#FAF8F5]/60 flex flex-col">
        <!-- Initial Welcome Message from AI -->
        <div class="flex items-start space-x-3 max-w-[85%] self-start">
          <div class="w-8 h-8 rounded-full bg-brand-orange text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm">
            N
          </div>
          <div class="bg-white p-4 rounded-2xl rounded-tl-none border border-gray-100 shadow-sm text-sm text-gray-800 leading-relaxed">
            <p class="font-bold text-brand-orange text-xs mb-1">Asisten NemuSnack</p>
            <p>Halo! Saya dapat membantu menemukan jajanan berdasarkan harga, jenis, lokasi, dan status lapak. Apa yang sedang Anda cari?</p>
          </div>
        </div>
      </div>

      <!-- Error Alert Box -->
      <div id="ai-error-box" class="hidden mx-6 sm:mx-8 mb-4 p-4 rounded-2xl bg-red-50 border border-red-200 text-xs text-red-700 flex items-start space-x-2.5">
        <span class="text-base">!</span>
        <div class="flex-1">
          <strong class="font-bold block mb-0.5">Pemberitahuan Layanan AI:</strong>
          <span id="ai-error-message">Asisten sedang mengalami kendala. Silakan coba kembali.</span>
        </div>
        <button onclick="dismissAiError()" type="button" class="text-red-400 hover:text-red-700 font-bold ml-2">✕</button>
      </div>

      <!-- Input Form -->
      <div class="p-4 sm:p-6 bg-white border-t border-gray-100">
        <form id="ai-chat-form" onsubmit="handleAiChatSubmit(event)" class="relative">
          <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
            <div class="relative flex-grow">
              <input type="text"
                     id="ai-user-query"
                     name="message"
                     maxlength="500"
                     autocomplete="off"
                     placeholder="Tanyakan jajanan (contoh: 'Apa saja produk yang tersedia?', 'Cari yang pedas')..."
                     class="w-full px-5 py-3.5 pr-14 rounded-2xl sm:rounded-full border border-gray-200 focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 text-sm outline-none transition-all placeholder:text-gray-400">
              <span id="ai-char-counter" class="absolute right-4 top-1/2 -translate-y-1/2 text-[10px] font-semibold text-gray-400 pointer-events-none">
                0/500
              </span>
            </div>
            <button type="submit"
                    id="ai-send-button"
                    class="px-7 py-3.5 rounded-2xl sm:rounded-full font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover disabled:bg-gray-300 disabled:cursor-not-allowed shadow-lg shadow-brand-orange/20 transition-all flex items-center justify-center space-x-2 shrink-0">
              <span id="ai-btn-text">Kirim</span>
              <span id="ai-btn-icon">➤</span>
            </button>
          </div>
          <div class="mt-2.5 flex items-center justify-end text-[11px] text-gray-400 px-2">
            <span class="italic">Maks. 500 karakter</span>
          </div>
        </form>
      </div>

    </div>
  </div>
</section>

