<!-- 2. FITUR UTAMA F-01: ASISTEN REKOMENDASI KULINER AI (CHATBOT WIDGET) -->
<section id="ai-assistant" class="py-14 bg-gradient-to-b from-white via-orange-50/40 to-white border-y border-orange-100">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-orange/10 text-brand-orange text-xs font-bold uppercase tracking-wider mb-2">
        Fitur F-01 (Must Priority PRD)
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
        ✨ Asisten Rekomendasi Jajanan NemuAI
      </h2>
      <p class="mt-2 text-sm text-gray-600">
        Ketik preferensi selera atau budgetmu (sesuai Acceptance Criteria US-01) untuk mendapatkan rekomendasi instan beserta lokasi PKL.
      </p>
    </div>

    <!-- AI Chatbot Interactive Container -->
    <div class="bg-white rounded-2xl border border-orange-200/80 shadow-xl overflow-hidden">
      <!-- Chat Header -->
      <div class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 px-6 py-4 flex items-center justify-between text-white">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-orange to-brand-amber flex items-center justify-center font-bold text-sm">
            AI
          </div>
          <div>
            <h3 class="text-sm font-bold">NemuAI Culinary Bot</h3>
            <p class="text-[11px] text-emerald-400 flex items-center">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1 animate-pulse"></span> Siap memberi rekomendasi jajanan
            </p>
          </div>
        </div>
        <span class="text-xs text-gray-400 font-mono hidden sm:inline">Endpoint: /api/rekomendasi</span>
      </div>

      <!-- Chat Body & Results -->
      <div class="p-6 space-y-4">
        
        <!-- Preset Prompt Buttons (Sesuai US-01 PRD) -->
        <div>
          <p class="text-xs font-semibold text-gray-500 mb-2">Coba pertanyaan cepat:</p>
          <div class="flex flex-wrap gap-2">
            <button onclick="askAiPrompt('cari makanan pedas murah')" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-orange-100/70 hover:bg-brand-orange hover:text-white text-brand-orange border border-orange-200 transition-colors">
              "cari makanan pedas murah"
            </button>
            <button onclick="askAiPrompt('jajanan manis lumer sore ini')" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-100/70 hover:bg-brand-amber hover:text-white text-amber-800 border border-amber-200 transition-colors">
              "jajanan manis lumer sore ini"
            </button>
            <button onclick="askAiPrompt('jajanan gurih')" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 hover:bg-gray-800 hover:text-white text-gray-700 transition-colors">
              "jajanan gurih di Pogung"
            </button>
          </div>
        </div>

        <!-- Chat Input Form -->
        <form onsubmit="handleAiSubmit(event)" class="flex gap-2">
          <input type="text" 
                 id="ai-user-query" 
                 placeholder="Tanya ke NemuAI (contoh: cari jajanan manis, pedas, atau murah)..." 
                 class="flex-grow px-4 py-3 rounded-xl border border-gray-300 focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 text-sm outline-none">
          <button type="submit" 
                  class="px-6 py-3 rounded-xl font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover transition-colors flex items-center">
            <span>Tanya AI</span>
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </form>

        <!-- AI Output Box -->
        <div id="ai-response-box" class="p-4 rounded-xl bg-orange-50/60 border border-orange-200 text-sm space-y-3">
          <div class="flex items-center space-x-2 text-brand-orange font-bold text-xs uppercase tracking-wider">
            <span>✨ Rekomendasi Asisten NemuAI:</span>
          </div>
          <div id="ai-result-content" class="text-gray-700 space-y-2">
            <p>Halo Salsa! Mau jajan apa hari ini? Klik salah satu contoh pertanyaan di atas atau ketik langsung makanan favoritmu!</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- 3. FEATURED SNACKS SECTION -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-orange/10 text-brand-orange text-xs font-bold uppercase tracking-wider mb-3">
        Katalog Populer PKL
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
        Jajanan Pilihan Terlaris di Sekitar Kampus
      </h2>
      <p class="mt-3 text-base sm:text-lg text-gray-600">
        Disajikan langsung oleh pedagang kaki lima binaan dengan cita rasa autentik dan harga ramah mahasiswa.
      </p>
    </div>

    <!-- Product Cards Grid (3 Featured Products) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
        <% featuredProducts.forEach((product) => { %>
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col overflow-hidden group">
            
            <!-- Card Image -->
            <div class="relative h-60 w-full overflow-hidden bg-gray-100">
              <img src="<%= product.image %>" 
                   alt="<%= product.name %>" 
                   class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                   onerror="this.onerror=null; this.src='/assets/images/snack-placeholder.svg';">
              
              <!-- Category Badge -->
              <span class="absolute top-3 left-3 bg-gray-900/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-1 rounded-lg shadow-sm">
                <%= product.category %>
              </span>

              <!-- Live Status Lapak Badge -->
              <% if (product.status === 'Mangkal') { %>
                <span class="absolute top-3 right-3 bg-emerald-500 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow flex items-center">
                  <span class="w-1.5 h-1.5 rounded-full bg-white mr-1.5 animate-pulse"></span> Mangkal
                </span>
              <% } else { %>
                <span class="absolute top-3 right-3 bg-brand-amber text-gray-950 text-[11px] font-extrabold px-2.5 py-1 rounded-md shadow flex items-center">
                  🚶 Sedang Berjalan
                </span>
              <% } %>
            </div>

            <!-- Card Body -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                  <span class="font-semibold text-brand-orange">📍 <%= product.seller %></span>
                  <span class="flex items-center text-amber-500 font-bold">★ <%= product.rating %> (<%= product.reviewsCount %>)</span>
                </div>

                <h3 class="text-xl font-bold text-gray-900 group-hover:text-brand-orange transition-colors">
                  <%= product.name %>
                </h3>
                <p class="mt-2 text-sm text-gray-600 line-clamp-2 leading-relaxed">
                  <%= product.description %>
                </p>

                <div class="mt-3 p-2.5 rounded-lg bg-orange-50/70 border border-orange-100 text-[11px] text-gray-600">
                  <span class="font-bold text-gray-800">Posisi:</span> <%= product.location %>
                </div>
              </div>

              <!-- Price & Action -->
              <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between">
                <div>
                  <span class="text-xs text-gray-400 block font-medium">Harga Menu</span>
                  <span class="text-xl font-extrabold text-brand-orange">
                    <%= formatCurrency(product.price) %>
                  </span>
                </div>

                <a href="/menu?id=<%= product.id %>" 
                   class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-bold text-gray-800 bg-orange-100 hover:bg-brand-orange hover:text-white transition-all duration-200">
                  <span>Pantau Route</span>
                  <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>

          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- More Button -->
    <div class="text-center mt-12">
      <a href="/menu" 
         class="inline-flex items-center px-7 py-3.5 rounded-xl font-bold text-sm text-white bg-gray-900 hover:bg-gray-800 shadow-md hover:shadow-lg transition-all duration-200">
        <span>Buka Katalog Lengkap &amp; Monitoring Lapak</span>
        <svg class="w-4 h-4 ml-2 text-brand-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

