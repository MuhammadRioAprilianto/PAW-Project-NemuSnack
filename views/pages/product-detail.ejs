<!-- Halaman Detail Produk & Ulasan Pembeli - NemuSnack -->
<section class="py-12 bg-[#FAF8F5]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs font-bold text-gray-500">
      <a href="/" class="hover:text-brand-orange">Home</a>
      <span>/</span>
      <a href="/menu" class="hover:text-brand-orange">Katalog Jajanan</a>
      <span>/</span>
      <span class="text-gray-900 truncate max-w-xs"><%= product.name %></span>
    </nav>

    <!-- Alerts -->
    <% if (typeof msg !== 'undefined' && msg) { %>
      <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 font-bold flex items-center space-x-2">
        <span>✓</span> <span><%= msg %></span>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-xs text-red-800 font-bold flex items-center space-x-2">
        <span>✕</span> <span><%= error %></span>
      </div>
    <% } %>

    <!-- 1. KONTEN UTAMA PRODUK (Grid 2 Kolom) -->
    <div class="bg-white rounded-[2.5rem] border border-gray-100 p-6 sm:p-10 shadow-card grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Kolom Kiri: Gambar Produk -->
      <div class="lg:col-span-6 flex flex-col">
        <div class="relative w-full h-80 sm:h-[420px] rounded-3xl overflow-hidden bg-gray-100 border border-gray-100 shadow-sm">
          <img src="<%= product.image %>" 
               alt="<%= product.name %>" 
               class="w-full h-full object-cover"
               onerror="this.src='/assets/images/snack-placeholder.svg'">
          
          <!-- Status Pill -->
          <% if (product.status === 'Mangkal') { %>
            <span class="absolute top-4 left-4 bg-white/95 backdrop-blur-md text-emerald-700 text-xs font-black px-3.5 py-1.5 rounded-full shadow-md flex items-center">
              <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse"></span> Sedang Mangkal
            </span>
          <% } else if (product.status === 'Sedang Berjalan') { %>
            <span class="absolute top-4 left-4 bg-white/95 backdrop-blur-md text-amber-800 text-xs font-black px-3.5 py-1.5 rounded-full shadow-md flex items-center">
              🚶 Sedang Berjalan (Keliling)
            </span>
          <% } else { %>
            <span class="absolute top-4 left-4 bg-white/95 backdrop-blur-md text-gray-700 text-xs font-black px-3.5 py-1.5 rounded-full shadow-md">
              💤 Lapak Tutup
            </span>
          <% } %>

          <span class="absolute top-4 right-4 bg-white/95 backdrop-blur-md text-gray-800 text-xs font-black px-3.5 py-1.5 rounded-full shadow-md">
            <%= product.category %>
          </span>
        </div>
      </div>

      <!-- Kolom Kanan: Detail & Aksi Pemesanan -->
      <div class="lg:col-span-6 flex flex-col justify-between space-y-6">
        <div>
          <!-- Seller Info -->
          <div class="flex items-center space-x-2 text-xs font-bold text-gray-500 mb-2">
            <span>📍 <%= product.seller || 'Lapak Pedagang' %></span>
            <span>•</span>
            <span class="font-mono text-gray-400">ID Produk: #<%= product.id %></span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
            <%= product.name %>
          </h1>

          <!-- Rating -->
          <div class="flex items-center space-x-3 mb-4">
            <div class="flex items-center text-amber-500 text-sm font-extrabold">
              <span>★ <%= product.rating %></span>
            </div>
            <span class="text-xs text-gray-400 font-bold">•</span>
            <span class="text-xs font-bold text-gray-600"><%= reviews.length %> Ulasan Pelanggan</span>
          </div>

          <!-- Price -->
          <div class="p-4 rounded-2xl bg-orange-50/70 border border-orange-100 mb-5">
            <span class="text-xs font-bold text-gray-500 block mb-0.5">Harga Spesial Lapak</span>
            <span class="text-3xl font-black text-brand-orange">
              <%= formatCurrency(product.price) %>
            </span>
          </div>

          <!-- Description -->
          <div class="space-y-2 mb-6">
            <h3 class="text-xs font-black text-gray-900 uppercase tracking-wider">Tentang Jajanan</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              <%= product.description || 'Jajanan kaki lima lezat diracik langsung di lapak saat pemesanan.' %>
            </p>
          </div>

          <!-- Titik Lokasi & Rute -->
          <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200 text-xs space-y-2 mb-6">
            <p><strong>Titik Lapak:</strong> <span class="text-gray-700"><%= product.location || 'Area Sekitar Kampus' %></span></p>
            <p><strong>Rute / Waktu:</strong> <span class="text-gray-700"><%= product.route || 'Standby sore hari' %></span></p>
          </div>
        </div>

        <!-- Tombol Hubungi WhatsApp / Order -->
        <div class="pt-4 border-t border-gray-100 flex flex-col sm:flex-row gap-3">
          <% if (product.whatsapp) { %>
            <a href="https://wa.me/<%= product.whatsapp.replace(/[^0-9]/g, '') %>?text=Halo%20<%= encodeURIComponent(product.seller || '') %>,%20saya%20tertarik%20dengan%20<%= encodeURIComponent(product.name) %>%20di%20NemuSnack!" 
               target="_blank" 
               class="flex-1 inline-flex items-center justify-center px-6 py-4 rounded-full font-black text-sm text-white bg-emerald-600 hover:bg-emerald-700 shadow-lg shadow-emerald-600/30 transition-all">
              <span class="text-lg mr-2">💬</span> Hubungi Pedagang via WhatsApp
            </a>
          <% } %>

          <a href="/menu" 
             class="inline-flex items-center justify-center px-6 py-4 rounded-full font-bold text-xs text-gray-700 bg-gray-100 hover:bg-gray-200 transition-colors">
            Kembali ke Katalog
          </a>
        </div>

      </div>

    </div>

    <!-- 2. PETA TITIK LOKASI LAPAK (Leaflet.js) -->
    <div class="bg-white rounded-[2.5rem] border border-gray-100 p-6 sm:p-8 shadow-card space-y-4">
      <div class="border-b border-gray-100 pb-3">
        <h2 class="text-lg font-black text-gray-900 flex items-center">
          <span class="mr-2">🗺️</span> Peta Titik Lapak Pedagang
        </h2>
        <p class="text-xs text-gray-500 mt-0.5">Lokasi GPS terkini pedagang: <%= product.location %></p>
      </div>

      <div id="product-map" class="w-full h-72 rounded-2xl overflow-hidden border border-gray-100"></div>
    </div>

    <!-- 3. BAGIAN ULASAN & RATING DARI PEMBELI -->
    <div class="bg-white rounded-[2.5rem] border border-gray-100 p-6 sm:p-8 shadow-card space-y-8">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-4">
        <div>
          <h2 class="text-xl font-black text-gray-900 flex items-center">
            <span class="mr-2">⭐</span> Ulasan &amp; Rating Pembeli
          </h2>
          <p class="text-xs text-gray-500 mt-0.5">
            Berikan testimoni dan nilai rasa untuk membantu penikmat kuliner lain menemukan jajanan terbaik.
          </p>
        </div>

        <div class="flex items-center space-x-2 bg-orange-50 px-4 py-2 rounded-2xl border border-orange-100">
          <span class="text-xl font-black text-brand-orange">★ <%= product.rating %></span>
          <span class="text-xs text-gray-500 font-bold">/ 5.0 (<%= reviews.length %> ulasan)</span>
        </div>
      </div>

      <!-- FORMULIR BERI ULASAN (UNTUK PEMBELI / USER LOGIN) -->
      <div class="p-6 rounded-3xl bg-[#FAF8F5] border border-gray-200/80">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <h3 class="text-sm font-black text-gray-900 mb-1">Tulis Ulasan Anda</h3>
          <p class="text-xs text-gray-500 mb-4">Masuk sebagai: <strong><%= currentUser.name %></strong> (<%= currentUser.role %>)</p>

          <form action="/produk/<%= product.id %>/reviews" method="POST" class="space-y-4">
            <div>
              <label class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5">
                Pilih Rating Kepuasan
              </label>
              <div class="flex items-center space-x-4">
                <label class="flex items-center space-x-1 cursor-pointer">
                  <input type="radio" name="rating" value="5" checked class="text-brand-orange">
                  <span class="text-xs font-bold text-amber-500">★★★★★ 5 Bintang</span>
                </label>
                <label class="flex items-center space-x-1 cursor-pointer">
                  <input type="radio" name="rating" value="4" class="text-brand-orange">
                  <span class="text-xs font-bold text-amber-500">★★★★ 4 Bintang</span>
                </label>
                <label class="flex items-center space-x-1 cursor-pointer">
                  <input type="radio" name="rating" value="3" class="text-brand-orange">
                  <span class="text-xs font-bold text-amber-500">★★★ 3 Bintang</span>
                </label>
              </div>
            </div>

            <div>
              <label class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5">
                Komentar Ulasan *
              </label>
              <textarea name="comment" required rows="3" placeholder="Ceritakan bagaimana rasa, porsi, kerenyahan, dan pelayanan jajanan ini..." class="w-full px-4 py-3 rounded-2xl border border-gray-200 text-xs focus:outline-none focus:border-brand-orange"></textarea>
            </div>

            <button type="submit" class="px-7 py-3 rounded-full font-black text-xs text-white bg-brand-orange hover:bg-brand-orange-hover shadow-md transition-all">
              Kirim Ulasan Sekarang
            </button>
          </form>
        <% } else { %>
          <div class="text-center py-4">
            <p class="text-sm font-bold text-gray-800 mb-2">Ingin memberikan rating &amp; komentar?</p>
            <p class="text-xs text-gray-500 mb-4">Silakan masuk dengan akun Pembeli Anda untuk menulis ulasan.</p>
            <a href="/login?redirect=/produk/<%= product.id %>" class="inline-flex px-6 py-2.5 rounded-full font-black text-xs text-white bg-brand-orange hover:bg-brand-orange-hover shadow-md transition-all">
              Masuk untuk Mengulas
            </a>
          </div>
        <% } %>
      </div>

      <!-- DAFTAR ULASAN DARI PEMBELI -->
      <div class="space-y-4">
        <% if (reviews && reviews.length > 0) { %>
          <% reviews.forEach(r => { %>
            <div class="p-4 rounded-2xl bg-white border border-gray-100 shadow-sm space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <div class="w-8 h-8 rounded-full bg-orange-100 text-brand-orange flex items-center justify-center font-bold text-xs">
                    <%= r.user_name.charAt(0) %>
                  </div>
                  <div>
                    <span class="text-xs font-black text-gray-900"><%= r.user_name %></span>
                    <span class="text-[10px] text-gray-400 block"><%= new Date(r.created_at).toLocaleDateString('id-ID') %></span>
                  </div>
                </div>

                <div class="flex items-center text-amber-500 text-xs font-extrabold">
                  <% for(let i=0; i < r.rating; i++) { %>★<% } %>
                  <span class="text-gray-700 font-bold ml-1.5"><%= r.rating %>/5</span>
                </div>
              </div>

              <p class="text-xs text-gray-700 leading-relaxed pl-10">
                <%= r.comment %>
              </p>
            </div>
          <% }); %>
        <% } else { %>
          <div class="text-center py-6 text-gray-400 text-xs">
            Belum ada ulasan untuk jajanan ini. Jadilah yang pertama memberikan ulasan!
          </div>
        <% } %>
      </div>

    </div>

  </div>
</section>

<!-- Leaflet Map Script untuk Detail Produk -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lat = <%= product.lat || -7.7660 %>;
    const lng = <%= product.lng || 110.3800 %>;
    const map = L.map('product-map').setView([lat, lng], 16);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap'
    }).addTo(map);

    const marker = L.marker([lat, lng]).addTo(map);
    marker.bindPopup(`<b><%= product.name %></b><br><%= product.seller %><br><%= product.location %>`).openPopup();
  });
</script>
