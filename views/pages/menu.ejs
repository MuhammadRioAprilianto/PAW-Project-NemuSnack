<section class="bg-white py-14 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-xs font-bold tracking-[0.18em] uppercase text-brand-orange">Katalog jajanan</p>
    <h1 class="mt-3 text-3xl sm:text-5xl font-black text-gray-900 tracking-tight">Temukan jajanan favoritmu</h1>
    <p class="mt-3 text-base text-gray-600 max-w-2xl mx-auto">
      Jelajahi pilihan jajanan dan temukan informasi lapak, harga, serta rute pedagang.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
      <button type="button" onclick="filterCategory('all')" id="cat-all" aria-pressed="true" class="category-filter px-4 py-2 rounded-full text-sm font-bold bg-brand-orange text-white transition-colors">Semua</button>
      <button type="button" onclick="filterCategory('Manis')" id="cat-manis" aria-pressed="false" class="category-filter px-4 py-2 rounded-full text-sm font-semibold bg-gray-50 text-gray-700 hover:bg-orange-50 hover:text-brand-orange border border-gray-200 transition-colors">Manis</button>
      <button type="button" onclick="filterCategory('Pedas')" id="cat-pedas" aria-pressed="false" class="category-filter px-4 py-2 rounded-full text-sm font-semibold bg-gray-50 text-gray-700 hover:bg-orange-50 hover:text-brand-orange border border-gray-200 transition-colors">Pedas</button>
      <button type="button" onclick="filterCategory('Gurih')" id="cat-gurih" aria-pressed="false" class="category-filter px-4 py-2 rounded-full text-sm font-semibold bg-gray-50 text-gray-700 hover:bg-orange-50 hover:text-brand-orange border border-gray-200 transition-colors">Gurih</button>
    </div>
  </div>
</section>

<section class="py-8 bg-[#FAF8F5] border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <form action="/menu" method="GET" role="search" class="flex flex-col sm:flex-row gap-3">
      <label for="product-search" class="sr-only">Cari berdasarkan nama produk</label>
      <div class="relative flex-grow">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z"/>
        </svg>
        <input type="search" id="product-search" name="q" value="<%= query %>" placeholder="Cari nama jajanan..." autocomplete="off"
               class="w-full pl-12 pr-4 py-3.5 rounded-full border border-gray-200 bg-white focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 text-sm outline-none transition-all">
      </div>
      <button type="submit" class="px-7 py-3.5 rounded-full font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover transition-colors">Cari jajanan</button>
      <% if (query) { %>
        <a href="/menu" class="px-6 py-3.5 rounded-full font-semibold text-sm text-gray-600 bg-white border border-gray-200 hover:bg-gray-50 text-center transition-colors">Hapus pencarian</a>
      <% } %>
    </form>
  </div>
</section>

<section class="py-14 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-7">
      <div>
        <h2 class="text-2xl font-black text-gray-900"><%= query ? 'Hasil pencarian' : 'Daftar jajanan' %></h2>
        <p class="text-sm text-gray-500 mt-1" id="product-result-count"><%= products.length %> dari <%= totalProducts %> produk</p>
      </div>
      <% if (query) { %>
        <p class="text-sm text-gray-600">Nama produk yang cocok dengan “<span class="font-semibold text-gray-900"><%= query %></span>”</p>
      <% } %>
    </div>

    <% if (products.length > 0) { %>
      <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7">
        <% products.forEach((product) => { %>
          <article data-category="<%= product.category %>" class="product-card bg-white rounded-3xl border border-gray-100 p-4 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-200 flex flex-col">
            <a href="/produk/<%= product.id %>" class="relative block h-60 w-full rounded-2xl overflow-hidden bg-gray-100" aria-label="Lihat detail <%= product.name %>">
              <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500" onerror="this.onerror=null; this.src='/assets/images/snack-placeholder.svg';">
              <% if (product.status === 'Mangkal') { %>
                <span class="absolute top-3 left-3 bg-white/95 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">Berjalan</span>
              <% } else if (product.status === 'Sedang Berjalan' || product.status === 'Berjalan') { %>
                <span class="absolute top-3 left-3 bg-white/95 text-amber-800 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">Berjalan</span>
              <% } else if (product.status === 'Libur') { %>
                <span class="absolute top-3 left-3 bg-white/95 text-slate-700 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">Libur</span>
              <% } else { %>
                <span class="absolute top-3 left-3 bg-white/95 text-gray-700 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">Tutup</span>
              <% } %>
            </a>

            <div class="px-1 pt-4 flex-1 flex flex-col">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="text-xs font-semibold text-gray-500 truncate"><%= product.seller %></p>
                  <h3 class="mt-1 text-xl font-extrabold text-gray-900"><%= product.name %></h3>
                </div>
                <span class="shrink-0 flex items-center gap-1 text-sm text-amber-500 font-bold" aria-label="Rating <%= Number(product.rating || 0).toFixed(1) %> dari 5">
                  <span aria-hidden="true">★</span><%= product.rating > 0 ? Number(product.rating).toFixed(1) : 'Baru' %>
                </span>
              </div>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed line-clamp-2"><%= product.description %></p>

              <div class="mt-4 p-3 rounded-xl bg-gray-50 border border-gray-100 text-sm space-y-1.5">
                <p class="text-gray-700 truncate"><span class="text-gray-400">Lokasi</span> · <%= product.location %></p>
                <% if (product.route) { %>
                  <p class="text-gray-500 truncate"><span class="text-gray-400">Rute</span> · <%= product.route %></p>
                <% } %>
              </div>

              <div class="mt-auto pt-4 flex items-end justify-between gap-3">
                <div>
                  <span class="text-xs text-gray-400 block">Harga</span>
                  <span class="text-xl font-black text-gray-900"><%= formatCurrency(product.price) %></span>
                </div>
                <a href="/produk/<%= product.id %>" class="px-5 py-2.5 rounded-full font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover transition-colors">Lihat detail</a>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
      <p id="category-empty-state" class="hidden mt-8 text-center text-gray-500">Tidak ada jajanan dalam kategori ini.</p>
    <% } else { %>
      <div class="py-16 px-6 text-center rounded-3xl border border-gray-100 bg-gray-50">
        <h3 class="text-lg font-bold text-gray-900">Jajanan tidak ditemukan</h3>
        <p class="mt-2 text-sm text-gray-500">Coba kata kunci nama produk yang lain.</p>
        <a href="/menu" class="inline-flex mt-5 px-5 py-2.5 rounded-full font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover transition-colors">Lihat semua jajanan</a>
      </div>
    <% } %>
  </div>
</section>

<script>
  function filterCategory(category) {
    const cards = Array.from(document.querySelectorAll('.product-card'));
    const buttons = Array.from(document.querySelectorAll('.category-filter'));
    let visibleCount = 0;

    buttons.forEach(button => {
      const active = button.id === `cat-${category.toLowerCase()}`;
      button.setAttribute('aria-pressed', String(active));
      button.className = active
        ? 'category-filter px-4 py-2 rounded-full text-sm font-bold bg-brand-orange text-white transition-colors'
        : 'category-filter px-4 py-2 rounded-full text-sm font-semibold bg-gray-50 text-gray-700 hover:bg-orange-50 hover:text-brand-orange border border-gray-200 transition-colors';
    });

    cards.forEach(card => {
      const visible = category === 'all' || card.dataset.category === category;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    });

    const emptyState = document.getElementById('category-empty-state');
    if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);
  }
</script>
