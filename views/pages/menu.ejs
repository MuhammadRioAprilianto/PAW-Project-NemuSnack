<!-- Halaman Katalog Jajanan & Lapak PKL - Agency Design Style -->

<!-- Header Banner Halaman Katalog -->
<section class="bg-white py-12 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-orange-100/70 border border-orange-200/60 text-brand-orange text-xs font-black tracking-wide mb-3">
      <span>• KATALOG JAJANAN PKL •</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-black text-gray-900 tracking-tight">
      Pilihan Jajanan Kaki Lima Terpopuler
    </h1>
    <p class="mt-3 text-base text-gray-600 max-w-2xl mx-auto">
      Temukan aneka jajanan street food legendaris di sekitarmu lengkap dengan titik lokasi lapak, status pergerakan gerobak, dan harga asli langsung dari pedagang.
    </p>

    <!-- Category Pill Filters (Matching Reference: All, Burgers, Pizza, Asian...) -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-2.5">
      <button onclick="filterCategory('all')" id="cat-all" class="px-5 py-2.5 rounded-full text-xs font-black bg-brand-orange text-white shadow-md shadow-brand-orange/20 transition-all">
        🍽️ Semua Jajanan
      </button>
      <button onclick="filterCategory('Manis')" id="cat-manis" class="px-5 py-2.5 rounded-full text-xs font-bold bg-[#FAF8F5] text-gray-700 hover:text-brand-orange hover:bg-orange-50 border border-gray-200 transition-all">
        🥞 Manis &amp; Lumer
      </button>
      <button onclick="filterCategory('Pedas')" id="cat-pedas" class="px-5 py-2.5 rounded-full text-xs font-bold bg-[#FAF8F5] text-gray-700 hover:text-brand-orange hover:bg-orange-50 border border-gray-200 transition-all">
        🌶️ Pedas Nampol
      </button>
      <button onclick="filterCategory('Gurih')" id="cat-gurih" class="px-5 py-2.5 rounded-full text-xs font-bold bg-[#FAF8F5] text-gray-700 hover:text-brand-orange hover:bg-orange-50 border border-gray-200 transition-all">
        🍢 Gorengan Gurih
      </button>
    </div>
  </div>
</section>

<!-- SECTION: CONTROL PANEL (Pencarian by ID & Kotak Pantau Route / Response API) -->
<section class="py-8 bg-[#FAF8F5] border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- 1. FORM PENCARIAN BY ID -->
    <div class="bg-white p-6 sm:p-7 rounded-[2rem] border border-gray-100 shadow-card">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="text-lg sm:text-xl font-black text-gray-900 flex items-center">
            <svg class="w-5 h-5 text-brand-orange mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            Pencarian Jajanan Berdasarkan ID
          </h2>
          <p class="text-xs text-gray-500 mt-0.5">
            Cari data produk spesifik untuk pengujian route endpoint <code class="bg-orange-100 text-brand-orange px-2 py-0.5 rounded-md font-mono text-xs font-bold">GET /api/produk/:id</code>
          </p>
        </div>

        <button type="button" 
                onclick="resetMenuFilter()"
                class="inline-flex items-center justify-center px-4 py-2 rounded-full text-xs font-bold text-gray-600 hover:text-brand-orange bg-gray-50 hover:bg-orange-50 border border-gray-200 transition-colors">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Reset / Tampilkan Semua
        </button>
      </div>

      <!-- Input Form (Pill Shape) -->
      <form id="search-id-form" onsubmit="handleIdSearch(event)" class="flex flex-col sm:flex-row items-stretch gap-3">
        <div class="relative flex-grow">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
            <span class="font-mono font-bold text-sm text-brand-orange">#ID</span>
          </div>
          <input type="number" 
                 id="search-id-input" 
                 min="1" 
                 placeholder="Ketik nomor ID (contoh: 1, 2, 3...)"
                 value="<%= typeof requestedId !== 'undefined' && requestedId ? requestedId : '' %>"
                 class="w-full pl-14 pr-4 py-3.5 rounded-full border border-gray-200 focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 text-sm outline-none transition-all"
                 required>
        </div>

        <button type="submit" 
                class="inline-flex items-center justify-center px-8 py-3.5 rounded-full font-black text-sm text-white bg-brand-orange hover:bg-brand-orange-hover shadow-lg shadow-brand-orange/20 active:scale-95 transition-all">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          Cari &amp; Ambil API
        </button>
      </form>

      <!-- Preset Quick Pills -->
      <div class="mt-4 pt-3 border-t border-gray-100 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-gray-500 mr-1">Uji Cepat:</span>
        <% if (typeof products !== 'undefined' && products.length > 0) { %>
          <% products.forEach((p) => { %>
            <button type="button" 
                    onclick="fetchProductById(<%= p.id %>)"
                    class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-orange-50 hover:bg-brand-orange hover:text-white text-gray-800 border border-orange-200 transition-all flex items-center">
              <span class="font-mono mr-1 text-brand-orange font-bold">#<%= p.id %></span> <%= p.name %>
            </button>
          <% }); %>
        <% } %>
        <button type="button" 
                onclick="fetchProductById(99)"
                class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-red-50 hover:bg-red-600 hover:text-white text-red-700 border border-red-200 transition-all flex items-center"
                title="Uji coba response 404">
          <span class="font-mono mr-1 font-bold">#99</span> Tes 404
        </button>
      </div>
    </div>

    <!-- 2. KOTAK KHUSUS PEMANTAU ROUTE & RESPONSE API (LIVE API INSPECTOR BOX) -->
    <div id="api-inspector-container" class="rounded-[2rem] overflow-hidden shadow-2xl border border-gray-800 bg-gray-950 text-gray-100 transition-all duration-300">
      
      <!-- Top Inspector Bar -->
      <div class="bg-black/60 px-5 sm:px-7 py-3.5 border-b border-gray-800 flex flex-wrap items-center justify-between gap-3">
        
        <div class="flex items-center space-x-3">
          <div class="flex items-center space-x-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
          </div>
          <span class="text-xs sm:text-sm font-bold text-gray-200 tracking-wide flex items-center">
            <svg class="w-4 h-4 text-brand-orange mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
            Live Route &amp; Response API Inspector
          </span>
        </div>

        <!-- Badges (Method, Route URL, Status Code) -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-1 rounded-md text-[11px] font-mono font-bold bg-blue-500/20 text-blue-400 border border-blue-500/30">
            HTTP GET
          </span>

          <span id="inspector-route-badge" class="px-2.5 py-1 rounded-md text-[11px] font-mono font-bold bg-gray-800 text-brand-amber border border-gray-700">
            /api/produk
          </span>

          <span id="inspector-status-badge" class="px-2.5 py-1 rounded-md text-[11px] font-mono font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5 animate-pulse"></span>
            200 OK
          </span>

          <button type="button" 
                  onclick="copyJsonResponse()"
                  class="px-3 py-1 rounded-md text-xs font-semibold bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white border border-gray-700 transition-colors flex items-center"
                  id="copy-btn">
            <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="copy-btn-text">Salin JSON</span>
          </button>
        </div>

      </div>

      <!-- Action Description & Meta Header -->
      <div class="px-5 sm:px-7 py-3 bg-gray-900 border-b border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-gray-300 gap-2">
        <div class="flex items-center space-x-2">
          <span class="text-gray-400 font-semibold">Aksi yang Sedang Dilakukan:</span>
          <span id="inspector-action-desc" class="font-bold text-brand-amber">
            Mengambil data katalog seluruh jajanan PKL NemuSnack
          </span>
        </div>
        <div class="flex items-center space-x-3 text-gray-400 text-[11px]">
          <span>Waktu: <span id="inspector-time" class="font-mono text-gray-200">-</span></span>
          <span>•</span>
          <a id="inspector-raw-link" href="/api/produk" target="_blank" class="text-brand-orange hover:underline flex items-center">
            Buka URL Endpoint Langsung
            <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- JSON Viewer Body -->
      <div class="p-5 sm:p-7 overflow-x-auto max-h-[380px] font-mono text-xs sm:text-sm bg-black/60">
        <pre id="inspector-json-content" class="text-emerald-300 leading-relaxed font-mono whitespace-pre-wrap break-all">// Memuat data Response API...</pre>
      </div>

    </div>

  </div>
</section>

<!-- Konten Grid Jajanan & Lapak PKL (Matching Zesty Reference Card Layout) -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Filter Status Alert -->
    <div id="filter-status-banner" class="hidden mb-8 p-4 rounded-2xl bg-orange-50 border border-brand-orange/30 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-8 h-8 rounded-full bg-brand-orange text-white flex items-center justify-center font-bold text-sm">
          ✓
        </div>
        <div>
          <p class="text-sm font-bold text-gray-900" id="filter-status-title">Menampilkan Lapak Terpilih</p>
          <p class="text-xs text-gray-600" id="filter-status-desc">Hanya menampilkan lapak berdasarkan pencarian ID.</p>
        </div>
      </div>
      <button onclick="resetMenuFilter()" class="text-xs font-bold text-brand-orange hover:underline px-3 py-1">
        Tampilkan Semua Lapak
      </button>
    </div>

    <!-- Responsive Cards Grid -->
    <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% if (typeof products !== 'undefined' && products.length > 0) { %>
        <% products.forEach((product) => { %>
          <div id="product-card-<%= product.id %>"
               data-product-id="<%= product.id %>"
               data-category="<%= product.category %>"
               class="product-card bg-white rounded-[2rem] border border-gray-100 p-4 shadow-card hover:shadow-card-hover hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group">
            
            <!-- Card Image (Matching Reference) -->
            <div class="relative h-64 w-full rounded-[1.5rem] overflow-hidden bg-gray-100 mb-5">
              <img src="<%= product.image %>" 
                   alt="<%= product.name %>" 
                   class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                   onerror="this.onerror=null; this.src='/assets/images/snack-placeholder.svg';">
              
              <!-- Status Pill (Top Left) -->
              <% if (product.status === 'Mangkal') { %>
                <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-emerald-700 text-xs font-extrabold px-3 py-1.5 rounded-full shadow-sm flex items-center">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span> Mangkal
                </span>
              <% } else { %>
                <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-amber-800 text-xs font-extrabold px-3 py-1.5 rounded-full shadow-sm flex items-center">
                  🚶 Berjalan
                </span>
              <% } %>

              <!-- Heart Button (Top Right) -->
              <button class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 backdrop-blur-md text-gray-500 hover:text-red-500 hover:bg-white flex items-center justify-center shadow-sm transition-colors">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              </button>
            </div>

            <!-- Detail Jajanan & Lapak -->
            <div class="px-2 pb-2 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                  <span class="font-bold text-gray-500">📍 <%= product.seller %></span>
                  <span class="flex items-center text-amber-500 font-extrabold">
                    ★ <%= product.rating %> <span class="text-gray-400 font-normal ml-1">(<%= product.reviewsCount %>)</span>
                  </span>
                </div>

                <h3 class="text-xl font-extrabold text-gray-900 group-hover:text-brand-orange transition-colors">
                  <%= product.name %>
                </h3>
                <p class="mt-2 text-xs text-gray-500 leading-relaxed line-clamp-2">
                  <%= product.description %>
                </p>

                <!-- Location & Route Box -->
                <div class="mt-3 p-3 rounded-2xl bg-orange-50/50 border border-orange-100 text-xs space-y-1">
                  <p class="text-gray-800 font-semibold truncate"><span class="text-gray-400">Titik:</span> <%= product.location %></p>
                  <p class="text-gray-500 italic text-[11px] truncate"><span class="text-gray-400 not-italic">Rute:</span> <%= product.route %></p>
                </div>
              </div>

              <!-- Price & Actions (Matching Reference) -->
              <div class="mt-5 pt-3 border-t border-gray-100 space-y-3">
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-[11px] text-gray-400 font-medium block">Harga</span>
                    <span class="text-2xl font-black text-gray-900">
                      <%= formatCurrency(product.price) %>
                    </span>
                  </div>
                  <span class="text-xs px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 font-mono font-bold">
                    ID: <%= product.id %>
                  </span>
                </div>

                <div class="grid grid-cols-2 gap-2 pt-1">
                  <!-- Cek Route API -->
                  <button type="button"
                          onclick="fetchProductById(<%= product.id %>)"
                          class="w-full inline-flex items-center justify-center px-3 py-2.5 rounded-full font-bold text-xs text-gray-800 bg-orange-50 hover:bg-brand-orange hover:text-white border border-orange-200 transition-all duration-200">
                    <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                    </svg>
                    <span>Cek Route API</span>
                  </button>

                  <!-- Datangi Lapak -->
                  <button type="button"
                          onclick="showLapakModal('<%= product.name %>', '<%= product.seller %>', '<%= formatCurrency(product.price) %>', '<%= product.location %>', '<%= product.status %>')"
                          class="w-full inline-flex items-center justify-center px-3 py-2.5 rounded-full font-bold text-xs text-white bg-brand-orange hover:bg-brand-orange-hover shadow-md shadow-brand-orange/20 transition-all duration-200">
                    <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    </svg>
                    <span>Datangi</span>
                  </button>
                </div>
              </div>

            </div>

          </div>
        <% }); %>
      <% } %>
    </div>

  </div>
</section>

<!-- Modal Informasi Lapak PKL -->
<div id="lapak-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl relative border border-gray-100 transform transition-all">
    <button onclick="closeLapakModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    <div class="w-12 h-12 rounded-2xl bg-orange-100 text-brand-orange flex items-center justify-center mx-auto mb-4">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
      </svg>
    </div>
    <h3 class="text-xl font-black text-gray-900 text-center" id="modal-product-name">Pisang Cokelat Pak Yono</h3>
    <p class="text-xs text-center text-gray-500 mt-0.5" id="modal-seller-name">Lapak Gerobak Pak Yono</p>
    <p class="text-xl font-black text-brand-orange text-center mt-2" id="modal-product-price">Rp 12.000</p>
    
    <div class="mt-5 p-4 rounded-2xl bg-orange-50 border border-orange-100 text-xs text-gray-700 space-y-2">
      <p><strong>Lokasi Lapak:</strong> <span id="modal-location">Jl. Kaliurang km 5</span></p>
      <p><strong>Status Operasional:</strong> <span id="modal-status" class="font-bold text-emerald-600">Mangkal</span></p>
      <div class="pt-2 border-t border-orange-200 text-[11px] text-gray-600">
        💡 Kunjungi langsung titik lapak di atas untuk menikmati hidangan segar dan hangat langsung dari wajan!
      </div>
    </div>
    <div class="mt-6 flex flex-col gap-2">
      <button onclick="closeLapakModal()" class="w-full py-3.5 rounded-full font-bold text-sm text-white bg-brand-orange hover:bg-brand-orange-hover transition-colors">
        Tutup &amp; Lanjutkan Melihat
      </button>
    </div>
  </div>
</div>

<!-- SCRIPT LIVE ROUTE & API INSPECTOR -->
<script>
  let currentJsonData = null;

  function getCurrentFormattedTime() {
    const now = new Date();
    return now.toLocaleTimeString('id-ID', { hour12: false }) + '.' + String(now.getMilliseconds()).padStart(3, '0');
  }

  function updateInspector({ route, statusCode, actionDesc, jsonData, isSuccess }) {
    currentJsonData = jsonData;
    
    const routeBadge = document.getElementById('inspector-route-badge');
    if (routeBadge) routeBadge.textContent = route;

    const statusBadge = document.getElementById('inspector-status-badge');
    if (statusBadge) {
      if (isSuccess) {
        statusBadge.className = 'px-2.5 py-1 rounded-md text-[11px] font-mono font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center';
        statusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5 animate-pulse"></span> ${statusCode} OK`;
      } else {
        statusBadge.className = 'px-2.5 py-1 rounded-md text-[11px] font-mono font-bold bg-red-500/20 text-red-400 border border-red-500/30 flex items-center';
        statusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-red-400 mr-1.5"></span> ${statusCode} Not Found`;
      }
    }

    const actionDescEl = document.getElementById('inspector-action-desc');
    if (actionDescEl) actionDescEl.textContent = actionDesc;

    const timeEl = document.getElementById('inspector-time');
    if (timeEl) timeEl.textContent = getCurrentFormattedTime();

    const rawLink = document.getElementById('inspector-raw-link');
    if (rawLink) {
      rawLink.href = route;
      rawLink.textContent = `Buka ${route}`;
    }

    const jsonPre = document.getElementById('inspector-json-content');
    if (jsonPre) {
      jsonPre.textContent = JSON.stringify(jsonData, null, 2);
      if (isSuccess) {
        jsonPre.className = 'text-emerald-300 leading-relaxed font-mono whitespace-pre-wrap break-all';
      } else {
        jsonPre.className = 'text-red-300 leading-relaxed font-mono whitespace-pre-wrap break-all';
      }
    }
  }

  async function fetchProductById(id) {
    const route = `/api/produk/${id}`;
    const actionDesc = `Mengambil data jajanan spesifik (ID: ${id}) via endpoint GET ${route}`;

    const statusBadge = document.getElementById('inspector-status-badge');
    if (statusBadge) {
      statusBadge.className = 'px-2.5 py-1 rounded-md text-[11px] font-mono font-bold bg-yellow-500/20 text-yellow-400 border border-yellow-500/30';
      statusBadge.textContent = 'Memuat...';
    }

    try {
      const response = await fetch(route);
      const data = await response.json();

      updateInspector({
        route,
        statusCode: response.status,
        actionDesc: data.message || actionDesc,
        jsonData: data,
        isSuccess: response.ok
      });

      filterGridByProductId(id, data.data);

      const inspectorEl = document.getElementById('api-inspector-container');
      if (inspectorEl && window.innerWidth < 768) {
        inspectorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

    } catch (error) {
      console.error('Fetch error:', error);
      updateInspector({
        route,
        statusCode: 500,
        actionDesc: `Terjadi error saat menghubungi ${route}`,
        jsonData: { success: false, message: error.message },
        isSuccess: false
      });
    }
  }

  function filterGridByProductId(id, productData) {
    const cards = document.querySelectorAll('.product-card');
    const banner = document.getElementById('filter-status-banner');
    const title = document.getElementById('filter-status-title');
    const desc = document.getElementById('filter-status-desc');

    if (productData) {
      banner.classList.remove('hidden');
      banner.className = 'mb-8 p-4 rounded-2xl bg-orange-50 border border-brand-orange/40 flex items-center justify-between transition-all';
      title.textContent = `Hasil Ditemukan: ${productData.name} (ID: ${id})`;
      desc.textContent = `Penjual: ${productData.seller} • Status: ${productData.status}.`;

      cards.forEach(card => {
        const cardId = card.getAttribute('data-product-id');
        if (cardId == id) {
          card.classList.remove('opacity-30', 'scale-95');
          card.classList.add('ring-4', 'ring-brand-orange', 'shadow-2xl', 'scale-100');
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          card.classList.add('opacity-30', 'scale-95');
          card.classList.remove('ring-4', 'ring-brand-orange', 'shadow-2xl');
        }
      });
    } else {
      banner.classList.remove('hidden');
      banner.className = 'mb-8 p-4 rounded-2xl bg-red-50 border border-red-200 flex items-center justify-between transition-all';
      title.textContent = `Jajanan ID #${id} Tidak Ditemukan (404)`;
      desc.textContent = `Sistem mengembalikan response 404 Not Found. Tidak ada lapak dengan ID ${id}.`;

      cards.forEach(card => {
        card.classList.add('opacity-30', 'scale-95');
        card.classList.remove('ring-4', 'ring-brand-orange', 'shadow-2xl');
      });
    }
  }

  function filterCategory(cat) {
    document.querySelectorAll('#cat-all, #cat-manis, #cat-pedas, #cat-gurih').forEach(btn => {
      btn.className = 'px-5 py-2.5 rounded-full text-xs font-bold bg-[#FAF8F5] text-gray-700 hover:text-brand-orange hover:bg-orange-50 border border-gray-200 transition-all';
    });

    const activeBtn = document.getElementById(`cat-${cat.toLowerCase()}`);
    if (activeBtn) {
      activeBtn.className = 'px-5 py-2.5 rounded-full text-xs font-black bg-brand-orange text-white shadow-md shadow-brand-orange/20 transition-all';
    }

    const cards = document.querySelectorAll('.product-card');
    cards.forEach(card => {
      card.classList.remove('ring-4', 'ring-brand-orange', 'opacity-30', 'scale-95');
      if (cat === 'all') {
        card.style.display = 'flex';
      } else {
        const cardCat = card.getAttribute('data-category');
        if (cardCat === cat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      }
    });
  }

  async function resetMenuFilter() {
    const searchInput = document.getElementById('search-id-input');
    if (searchInput) searchInput.value = '';

    const banner = document.getElementById('filter-status-banner');
    if (banner) banner.classList.add('hidden');

    const cards = document.querySelectorAll('.product-card');
    cards.forEach(card => {
      card.style.display = 'flex';
      card.classList.remove('opacity-30', 'scale-95', 'ring-4', 'ring-brand-orange', 'shadow-2xl');
    });

    try {
      const response = await fetch('/api/produk');
      const data = await response.json();
      updateInspector({
        route: '/api/produk',
        statusCode: 200,
        actionDesc: 'Mengambil data katalog seluruh jajanan PKL NemuSnack',
        jsonData: data,
        isSuccess: true
      });
    } catch (err) {
      console.error(err);
    }
  }

  function handleIdSearch(event) {
    event.preventDefault();
    const idInput = document.getElementById('search-id-input');
    if (idInput && idInput.value) {
      fetchProductById(idInput.value.trim());
    }
  }

  function copyJsonResponse() {
    if (!currentJsonData) return;
    navigator.clipboard.writeText(JSON.stringify(currentJsonData, null, 2)).then(() => {
      const btnText = document.getElementById('copy-btn-text');
      if (btnText) {
        btnText.textContent = 'Tersalin!';
        setTimeout(() => {
          btnText.textContent = 'Salin JSON';
        }, 2000);
      }
    });
  }

  function showLapakModal(name, seller, price, location, status) {
    document.getElementById('modal-product-name').textContent = name;
    document.getElementById('modal-seller-name').textContent = seller;
    document.getElementById('modal-product-price').textContent = price;
    document.getElementById('modal-location').textContent = location;
    document.getElementById('modal-status').textContent = status;
    document.getElementById('lapak-modal').classList.remove('hidden');
  }

  function closeLapakModal() {
    document.getElementById('lapak-modal').classList.add('hidden');
  }

  window.addEventListener('click', function(e) {
    const modal = document.getElementById('lapak-modal');
    if (e.target === modal) {
      closeLapakModal();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const initialId = <%= typeof requestedId !== 'undefined' && requestedId ? requestedId : 'null' %>;
    if (initialId) {
      fetchProductById(initialId);
    } else {
      resetMenuFilter();
    }
  });
</script>
