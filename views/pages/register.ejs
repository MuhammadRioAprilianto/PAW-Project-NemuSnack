<!-- Halaman Registrasi Akun Baru - NemuSnack -->
<section class="py-16 sm:py-20">
  <div class="max-w-md mx-auto px-4 sm:px-6">
    <div class="bg-white rounded-[2.5rem] border border-gray-100 p-8 sm:p-10 shadow-2xl shadow-orange-500/5 relative">
      
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="w-16 h-16 rounded-3xl bg-brand-orange text-white flex items-center justify-center mx-auto mb-4 shadow-lg shadow-brand-orange/30">
          <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24">
            <path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
          Buat Akun Baru
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">
          Bergabung bersama jaringan kuliner kaki lima NemuSnack
        </p>
      </div>

      <!-- Alerts -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-200 text-xs text-red-700 flex items-center space-x-2">
          <svg class="w-4 h-4 shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <span class="font-bold"><%= error %></span>
        </div>
      <% } %>

      <!-- Form Register -->
      <form action="/register" method="POST" class="space-y-4">
        
        <!-- Pilihan Role (Penjual vs Pembeli) -->
        <div>
          <label class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-2">
            Daftar Sebagai Peran
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="relative flex flex-col items-center p-3 rounded-2xl border-2 cursor-pointer transition-all border-brand-orange bg-orange-50/50" id="role-penjual-label">
              <input type="radio" name="role" value="penjual" checked class="sr-only" onchange="toggleRoleUI('penjual')">
              <span class="text-2xl mb-1">🏪</span>
              <span class="text-xs font-black text-gray-900">Penjual / PKL</span>
              <span class="text-[10px] text-gray-500 text-center">Kelola lapak & jajanan</span>
            </label>

            <label class="relative flex flex-col items-center p-3 rounded-2xl border-2 cursor-pointer transition-all border-gray-200 hover:border-gray-300" id="role-pembeli-label">
              <input type="radio" name="role" value="pembeli" class="sr-only" onchange="toggleRoleUI('pembeli')">
              <span class="text-2xl mb-1">🛒</span>
              <span class="text-xs font-black text-gray-900">Pembeli</span>
              <span class="text-[10px] text-gray-500 text-center">Jelajahi & beri ulasan</span>
            </label>
          </div>
        </div>

        <div>
          <label for="name" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5" id="name-label">
            Nama Usaha / Nama Lengkap
          </label>
          <input type="text" 
                 id="name" 
                 name="name" 
                 required 
                 placeholder="Contoh: Pisang Keju Lumer Mang Udin"
                 class="w-full px-4 py-3 rounded-2xl border border-gray-200 text-sm focus:outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 transition-all">
        </div>

        <div>
          <label for="email" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5">
            Alamat Email
          </label>
          <input type="email" 
                 id="email" 
                 name="email" 
                 required 
                 placeholder="nama@email.com"
                 class="w-full px-4 py-3 rounded-2xl border border-gray-200 text-sm focus:outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 transition-all">
        </div>

        <div>
          <label for="phone" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5">
            Nomor WhatsApp / HP
          </label>
          <input type="text" 
                 id="phone" 
                 name="phone" 
                 placeholder="081234567890"
                 class="w-full px-4 py-3 rounded-2xl border border-gray-200 text-sm focus:outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 transition-all">
        </div>

        <div>
          <label for="password" class="block text-xs font-black text-gray-700 uppercase tracking-wider mb-1.5">
            Password
          </label>
          <input type="password" 
                 id="password" 
                 name="password" 
                 required 
                 minlength="6"
                 placeholder="Minimal 6 karakter"
                 class="w-full px-4 py-3 rounded-2xl border border-gray-200 text-sm focus:outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 transition-all">
        </div>

        <button type="submit" 
                class="w-full py-3.5 rounded-full font-black text-sm text-white bg-brand-orange hover:bg-brand-orange-hover shadow-lg shadow-brand-orange/30 hover:shadow-xl hover:shadow-brand-orange/40 transition-all duration-200 active:scale-95">
          Daftar Sekarang
        </button>
      </form>

      <!-- Footer Links -->
      <div class="mt-6 text-center">
        <p class="text-xs text-gray-500">
          Sudah memiliki akun? 
          <a href="/login" class="font-bold text-brand-orange hover:underline">
            Masuk di sini
          </a>
        </p>
      </div>

    </div>
  </div>
</section>

<script>
  function toggleRoleUI(role) {
    const penjualLabel = document.getElementById('role-penjual-label');
    const pembeliLabel = document.getElementById('role-pembeli-label');
    const nameLabel = document.getElementById('name-label');
    const nameInput = document.getElementById('name');

    if (role === 'penjual') {
      penjualLabel.className = 'relative flex flex-col items-center p-3 rounded-2xl border-2 cursor-pointer transition-all border-brand-orange bg-orange-50/50';
      pembeliLabel.className = 'relative flex flex-col items-center p-3 rounded-2xl border-2 cursor-pointer transition-all border-gray-200 hover:border-gray-300';
      nameLabel.textContent = 'Nama Usaha / Nama Gerobak PKL';
      nameInput.placeholder = 'Contoh: Pisang Keju Lumer Mang Udin';
    } else {
      pembeliLabel.className = 'relative flex flex-col items-center p-3 rounded-2xl border-2 cursor-pointer transition-all border-brand-orange bg-orange-50/50';
      penjualLabel.className = 'relative flex flex-col items-center p-3 rounded-2xl border-2 cursor-pointer transition-all border-gray-200 hover:border-gray-300';
      nameLabel.textContent = 'Nama Lengkap Pembeli';
      nameInput.placeholder = 'Contoh: Budi Santoso';
    }
  }
</script>
