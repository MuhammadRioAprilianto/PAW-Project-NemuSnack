<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'NemuSnack - Jajanan Kaki Lima Favoritmu, Dilacak Real-Time' %></title>
  
  <!-- Favicon / SVG Icon NemuSnack -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23FF532A'><path d='M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z'/></svg>">
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Leaflet.js CSS (Peta Pelacakan Interaktif) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              orange: '#FF532A',
              'orange-hover': '#E03E16',
              'orange-light': '#FFF0ED',
              amber: '#F59E0B',
              dark: '#111827',
              gray: '#6B7280',
              cream: '#FAF8F5',
              emerald: '#10B981'
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', '-apple-system', 'sans-serif'],
          },
          boxShadow: {
            'card': '0 10px 30px -5px rgba(0, 0, 0, 0.05)',
            'card-hover': '0 20px 40px -10px rgba(255, 83, 42, 0.12)',
          }
        }
      }
    }
  </script>

  <!-- Leaflet.js JavaScript CDN -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <style>
    body {
      background-color: #FAF8F5;
      color: #111827;
      font-feature-settings: "cv02", "cv03", "cv04", "cv11";
    }
    /* Custom Leaflet styling */
    .leaflet-popup-content-wrapper {
      border-radius: 1rem;
      padding: 0.25rem;
      box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.15);
    }
  </style>
</head>
<body class="font-sans antialiased bg-[#FAF8F5] text-gray-900 flex flex-col min-h-screen">

  <!-- Header & Navigasi -->
  <%- include('../partials/navbar') %>

  <!-- Konten Utama Halaman -->
  <main class="flex-grow">
    <%- body %>
  </main>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Drawer Middleware Logger & Live API CRUD Inspector (GET, POST, PUT, DELETE) -->
  <%- include('../partials/middleware-logger-drawer') %>

  <!-- Script untuk interaktivitas umum -->
  <script>
    // Smooth scroll handling
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        const targetId = this.getAttribute('href');
        if (targetId.length > 1) {
          const target = document.querySelector(targetId);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });
  </script>
</body>
</html>
